{
  "description": "segmem: doctrine and wake at session start, recall and one memory-upkeep ask on prompts, recall before every Bash command",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/segmem\" prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/segmem\" wake --once",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/segmem\" hook --once",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/segmem\" hook --tool --once",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "hooks.ts"
  ]
}
