<script>
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const short = s => s === 'global' ? 'global' : String(s).split('/').pop();
const S = {tab: 'console', scope: null, sel: null, q: '', f: {}, writes: 0, me: 'segmem', open: [], newest: null};
const j = async u => (await fetch(u)).json();
const fmtCounts = n => ['note','recall','prompt'].filter(k => n[k]).map(k => `${n[k]} ${k}${n[k] === 1 ? '' : 's'}`).join(', ') || 'no touches';

// ---- console
async function loadConsole() {
  const d = await j('/api/state' + (S.scope ? '?scope=' + encodeURIComponent(S.scope) : ''));
  S.scope = d.scope; S.me = d.me;
  $('#dbp').textContent = d.db;
  $('#scopes').innerHTML = '<span class="mut">scope</span>' + d.scopes.map(s =>
    `<button class="chip${s.scope === d.scope ? ' on' : ''}" data-s="${esc(s.scope)}">${esc(short(s.scope))} <span class="mut">${s.n}</span></button>`).join('') +
    `<span class="mut" style="margin-left:auto">episodic budget ${d.budget}</span>`;
  let sec = '';
  $('#wake').innerHTML = d.wake.split('\n').map(line => {
    if (line.startsWith('#' + '#')) { sec = line; return `<div class="hd">${esc(line)}</div>`; }
    let m;
    if (sec.startsWith('### Episodic')) {
      const map = d.seq[(sec.match(/\((.*)\)/) || [])[1]] || {};
      if ((m = line.match(/^#(\d+)-(\d+) /))) return `<div class="ln sum"><span class="gut">#${m[1]}-${m[2]}</span><span class="tx">${esc(line.slice(m[0].length))}</span><span class="rid">summary</span></div>`;
      if ((m = line.match(/^#(\d+) /))) { const id = map[m[1]]; return `<div class="ln${id === S.sel ? ' on' : ''}" data-id="${id}"><span class="gut">#${m[1]}</span><span class="tx">${esc(line.slice(m[0].length))}</span><span class="rid">id ${id}</span></div>`; }
    } else if (/^#\d+ /.test(line)) {
      const ids = [...line.matchAll(/#(\d+) /g)].map(x => +x[1]);
      return `<div class="ln${ids.includes(S.sel) ? ' on' : ''}" data-id="${ids[0]}"><span class="tx">${esc(line)}</span></div>`;
    }
    return `<div class="pl">${esc(line)}</div>`;
  }).join('');
  if (S.sel) loadFact(S.sel);
}
async function loadFact(id) {
  S.sel = id;
  document.querySelectorAll('#wake .ln').forEach(el => el.classList.toggle('on', +el.dataset.id === id));
  const f = await j('/api/fact?id=' + id);
  $('#insp').innerHTML = f.error ? `<p class="mut">No memory #${id}.</p>` : factHTML(f);
}
function factHTML(f) {
  const me = S.me, ents = f.entities_list;
  const cmd = c => `<div class="cmd"><code>${esc(c)}</code><button class="cp" data-c="${esc(c)}">copy</button></div>`;
  let h = `<div class="fh"><b>#${f.id}</b><span class="k ${f.kind}">${f.kind}</span><span class="mut">${esc(short(f.scope))} · ${f.ts.slice(0, 10)} · seq ${f.seq} of ${f.total_in_stream}${f.dead ? ' · superseded' : ''}</span></div>
    <p class="ft${f.dead ? ' dead' : ''}">${esc(f.text)}</p>`;
  h += `<h4>Why it prints</h4><p>${esc(f.why)}</p>`;
  if (ents.length) h += `<p class="mut">Entities: ${ents.map(e => `<a class="ent" data-e="${esc(e)}">${esc(e)}</a>`).join(', ')}</p>`;
  if (f.conflicts.length) h += `<h4>Shares a subject with</h4>` + f.conflicts.map(c => `<div class="ln" data-id="${c.id}">#${c.id} ${esc(c.text)} <span class="mut">(${esc(short(c.scope))})</span></div>`).join('');
  if (f.threshold) {
    const pct = Math.min(100, 100 * f.pressure / f.threshold);
    h += `<h4>Pressure</h4><div class="bar"><i style="width:${pct}%"${f.hot ? ' class="hot"' : ''}></i></div>
      <p class="mut">${f.pressure} / ${f.threshold} · ${fmtCounts(f.touches)} since ${f.since.slice(0, 10)}${f.last_touch ? ' · last ' + f.last_touch.slice(0, 16).replace('T', ' ') : ''}</p>
      <p${f.hot ? ' class="warn"' : ''}>${esc(f.verdict)}</p>`;
  } else if (ents.length) {
    h += `<h4>Touches</h4><p class="mut">${fmtCounts(f.touches)} since it was written; episodic notes carry no pressure.</p>`;
  }
  if (f.ladder) h += `<h4>Form ladder</h4><p class="mut">Export target: ${esc(f.ladder)}.</p>`;
  h += `<h4>History</h4><p class="mut">${f.replaces ? `Replaces <a class="ent" data-id="${f.replaces.id}">#${f.replaces.id}</a> (${f.replaces.ts.slice(0, 10)}). ` : ''}${f.superseded_by ? `Superseded by <a class="ent" data-id="${f.superseded_by.id}">#${f.superseded_by.id}</a> (${f.superseded_by.ts.slice(0, 10)}).` : 'Live; superseded by nothing.'}</p>`;
  h += `<h4>Commands</h4>`;
  if (f.kind === 'procedural' && !f.dead) h += cmd(`${me} touch ${f.id}`) + (f.hot ? cmd(`${me} touch ${f.id} --keep`) : '');
  if (!f.dead) h += cmd(`${me} note ${f.kind} "…" --supersedes=${f.id}${ents.length ? ' --entities=' + ents.join(',') : ''}`);
  if (ents.length) h += cmd(`${me} recall ${ents[0]}`);
  return h;
}

// ---- ledger
let qTimer;
async function loadLedger() {
  const p = new URLSearchParams({q: S.q, ...S.f});
  const d = await j('/api/search?' + p);
  $('#qmeta').textContent = d.error ? d.error : `${d.total} hit${d.total === 1 ? '' : 's'} · ${d.ms} ms${d.total > d.rows.length ? ' · showing ' + d.rows.length : ''}`;
  const fac = (key, obj, label) => `<h4>${label}</h4>` + (Object.keys(obj).length ? Object.entries(obj).map(([k, n]) =>
    `<div class="f${S.f[key] === k ? ' on' : ''}" data-fk="${key}" data-fv="${esc(k)}"><span>${esc(key === 'scope' ? short(k) : k)}</span><span>${n}</span></div>`).join('') : '<div class="mut">none</div>');
  $('#facets').innerHTML = fac('kind', d.facets.kind || {}, 'Kind') + fac('scope', d.facets.scope || {}, 'Scope') + fac('entity', d.facets.entity || {}, 'Entities in results') +
    `<h4>Superseded</h4><div class="f${S.f.dead === '1' ? ' on' : ''}" data-fk="dead" data-fv="1"><span>show superseded rows</span><span></span></div>` +
    (Object.keys(S.f).length ? `<h4>&nbsp;</h4><div class="f" data-clear="1"><span>clear filters</span><span></span></div>` : '');
  const terms = S.q.split(/\s+/).filter(t => t && !/^(AND|OR|NOT)$/.test(t)).map(t => t.replace(/^"|"$/g, ''));
