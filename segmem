#!/usr/bin/env python3
"""segmem: segmented, scoped memory for agents. One file, SQLite, no daemon.

Layers, lakehouse style:
  bronze  memories   append-only facts; never edited, only superseded
  silver  kind/scope/entities columns, filled at write time; FTS5 over text
  gold    summaries  the episodic merge tree, per scope; rebuildable from bronze

Kinds, and what wake does with each:
  identity    who the user is, how they like to work   loaded whole   supersedes
  procedural  how things work here                     loaded whole   supersedes
  episodic    what happened                            decaying cover  history
  people      who someone is                           names only; recall by name

Touches are telemetry, not memory: who got mentioned, recalled, or tagged,
pressing on the people dossiers and procedural facts. Wake never prints
them as facts.
"""
import os
import re
import sqlite3
import subprocess
import sys

KINDS = ("identity", "procedural", "episodic", "people")
GLOBAL = "global"
MAX_BYTES = 280
WAKE_EPISODIC = 16      # lines of project episodic cover
WAKE_EPISODIC_GLOBAL = 8
WAKE_PROCEDURAL = 32    # newest procedural notes printed in full; recall finds the rest
PROMOTE_MIN = 3         # see should_promote()
STALE_MIN = 6           # weighted touches before a dossier is under pressure
PROC_STALE_MIN = 12     # same, per procedural note; hub entities accrue fast
TOUCH_WEIGHT = {"note": 3, "recall": 2, "prompt": 1}

ME = os.path.abspath(sys.argv[0])


# ---------------------------------------------------------------- store

def db_path():
    d = os.environ.get("SEGMEM_DIR") or os.path.expanduser("~/.segmem")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "segmem.db")


SCHEMA = """
CREATE TABLE IF NOT EXISTS memories (
  id         INTEGER PRIMARY KEY,
  ts         TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  kind       TEXT NOT NULL CHECK (kind IN ('identity','procedural','episodic','people')),
  scope      TEXT NOT NULL,
  seq        INTEGER NOT NULL,           -- position within (kind, scope) stream
  entities   TEXT NOT NULL DEFAULT '',   -- comma-separated subjects: people, components
  supersedes INTEGER REFERENCES memories(id),
  text       TEXT NOT NULL,
  UNIQUE (kind, scope, seq)
);
CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
  text, entities, content='memories', content_rowid='id'
);
CREATE TRIGGER IF NOT EXISTS memories_ai AFTER INSERT ON memories BEGIN
  INSERT INTO memories_fts(rowid, text, entities) VALUES (new.id, new.text, new.entities);
END;
CREATE TABLE IF NOT EXISTS summaries (
  kind  TEXT NOT NULL, scope TEXT NOT NULL,
  lo    INTEGER NOT NULL, hi INTEGER NOT NULL,
  text  TEXT NOT NULL,
  PRIMARY KEY (kind, scope, lo, hi)
);
CREATE TABLE IF NOT EXISTS touches (
  ts      TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  entity  TEXT NOT NULL,
  kind    TEXT NOT NULL CHECK (kind IN ('note','recall','prompt','review','nag')),
  session TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS touches_by_entity ON touches(entity, ts);
CREATE TABLE IF NOT EXISTS claims (
  ts      TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  session TEXT NOT NULL,
  cmd     TEXT NOT NULL,                 -- which command served the session
  source  TEXT NOT NULL,                 -- startup, resume, compact, clear, fork
  served  TEXT NOT NULL,                 -- 'command' hook or 'function' hook
  PRIMARY KEY (session, cmd, source)
);
"""


def connect():
    c = sqlite3.connect(db_path(), timeout=10)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA foreign_keys=ON")
    c.executescript(SCHEMA)
    return c


def project():
    """Scope key for the cwd: the main repo path, shared across worktrees."""
    if os.environ.get("SEGMEM_PROJECT"):
        return os.environ["SEGMEM_PROJECT"]
    try:
        common = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return GLOBAL
    return os.path.dirname(os.path.abspath(common))


LIVE = "id NOT IN (SELECT supersedes FROM memories WHERE supersedes IS NOT NULL)"


def live(c, kind, scopes):
    q = ("SELECT * FROM memories WHERE kind=? AND scope IN (%s) AND %s ORDER BY id"
         % (",".join("?" * len(scopes)), LIVE))
    return c.execute(q, (kind, *scopes)).fetchall()


def stream_len(c, kind, scope):
    # MAX+1, not COUNT: forget can leave a hole in a non-episodic stream, and
    # a reused seq would collide with the rows past it.
    r = c.execute("SELECT COALESCE(MAX(seq)+1, 0) FROM memories WHERE kind=? AND scope=?",
                  (kind, scope)).fetchone()
    return r[0]


def entity_set(row):
    return {e.strip().lower() for e in row["entities"].split(",") if e.strip()}


# ---------------------------------------------------------------- tree
# An aligned power-of-two block [lo,hi) of one (kind, scope) stream is
# summarised into one line. Blocks form a binary merge tree; wake prints a
# budget-bounded cover of it, finest near the present. The shape is an
# exponential histogram (Datar, Gionis, Indyk, Motwani, 2002): a block may
# be as wide as it is old, so each doubling of age gets about the same
# number of lines.

def cover(T, budget):
    """At most `budget` aligned blocks tiling [0,T), newest finest.

    Greedy: keep a heap of blocks keyed by age/size, where age is the
    distance from the block's start to the present. Split the block with the
    smallest ratio (the widest for its age) until the budget is spent. A
    block that overhangs the end of the stream must split first; a single
    memory is final. One pass, O(budget log budget)."""
    if T <= 0:
        return []
    if T <= budget:
        return [(i, i + 1) for i in range(T)]
    import heapq
    root = 1 << (T - 1).bit_length()

    def key(lo, hi):
        if hi > T:
            return (-1.0, -lo)               # overhang: must split
        return ((T - lo) / (hi - lo), -lo)   # widest for its age, newest first

    heap, done = [(key(0, root), 0, root)], []
    while heap and len(heap) + len(done) < budget:
        _, lo, hi = heapq.heappop(heap)
        mid = (lo + hi) // 2
        for a, b in ((lo, mid), (mid, hi)):
            if a >= T:
                continue
            if b - a == 1:
                done.append((a, b))
            else:
                heapq.heappush(heap, (key(a, b), a, b))
    out = done + [(lo, hi) for _, lo, hi in heap]
    if any(hi > T for _, hi in out):
        # the budget ran out before every overhang split: split those
        # regardless, since a block past the end cannot be summarised
        fixed = []
        for lo, hi in out:
            while hi > T:
                mid = (lo + hi) // 2
                if mid >= T:
                    hi = mid
                else:
                    fixed.append((lo, mid))
                    lo = mid
            fixed.append((lo, hi))
        out = fixed
    return sorted(out)


def summary(c, kind, scope, lo, hi):
    r = c.execute("SELECT text FROM summaries WHERE kind=? AND scope=? AND lo=? AND hi=?",
                  (kind, scope, lo, hi)).fetchone()
    return r[0] if r else None


def budget_for(scope):
    """Lines of episodic cover wake prints for a scope, from the cwd's view."""
    p = project()
    return WAKE_EPISODIC if scope == p or p == GLOBAL else WAKE_EPISODIC_GLOBAL


def pending(c, kind, scope, T):
    """Blocks wake needs and does not have, smallest first. A block is needed
    when the cover prints it, or when a needed block's summary is built from
    it. Blocks the cover does not print are never requested: no premature
    compression."""
    need = []

    def walk(lo, hi):
        if hi - lo == 1 or summary(c, kind, scope, lo, hi) is not None:
            return
        mid = (lo + hi) // 2
        walk(lo, mid)
        walk(mid, hi)
        need.append((lo, hi))

    for lo, hi in cover(T, budget_for(scope)):
        walk(lo, hi)
    return sorted(set(need), key=lambda b: (b[1] - b[0], b[0]))


def span(c, scope, lo, hi):
    """The dates a block of episodic memories covers: one date, or first..last."""
    r = c.execute("SELECT MIN(ts), MAX(ts) FROM memories WHERE kind='episodic' AND scope=? "
                  "AND seq>=? AND seq<?", (scope, lo, hi)).fetchone()
    a, b = (r[0] or "")[:10], (r[1] or "")[:10]
    return a if a == b else "%s..%s" % (a, b[5:])


def nap_prompt(c, kind, scope, lo, hi, left):
    if hi - lo == 2:
        rows = c.execute("SELECT seq, ts, text FROM memories WHERE kind=? AND scope=? "
                         "AND seq>=? AND seq<? ORDER BY seq", (kind, scope, lo, hi))
        body = "\n".join("  #%d %s %s" % (r["seq"], r["ts"][:10], r["text"]) for r in rows)
    else:
        mid, halves = (lo + hi) // 2, []
        for a, b in ((lo, mid), (mid, hi)):
            s = summary(c, kind, scope, a, b)
            if s is None:
                die("Summary #%d-%d is missing; the tree will rebuild it on the next nap."
                    % (a, b - 1))
            halves.append("  #%d-%d %s %s" % (a, b - 1, span(c, scope, a, b), s))
        body = "\n".join(halves)
    tail = "" if not left else "\n%d compression%s remain after this one." % (
        left, "" if left == 1 else "s")
    return ("Compress episodic memories #%d-%d (%s) into one line of at most %d "
            "bytes.\nKeep what has lasting effect, drop what does not. Invent "
            "nothing.\nKeep doubts as doubts: an unknown cause must not become "
            "a cause.\n\n%s\n%s\nRun: %s nap %d-%d \"<your line>\""
            % (lo, hi - 1, short(scope), MAX_BYTES, body, tail, ME, lo, hi - 1))


def next_nap(c, scope):
    """(scope, prompt, lo, hi) for the compression wake would ask for, or
    None. The tail is appended, not prepended: three callers read [0] and
    [1] and none of them care about the range."""
    for sc in (scope, GLOBAL) if scope != GLOBAL else (GLOBAL,):
        T = stream_len(c, "episodic", sc)
        todo = pending(c, "episodic", sc, T)
        if todo:
            lo, hi = todo[0]
            return sc, nap_prompt(c, "episodic", sc, lo, hi, len(todo) - 1), lo, hi - 1
    return None


# ---------------------------------------------------------------- promotion

def norm(text):
    return " ".join(re.sub(r"[^\w\s]", " ", text.lower()).split())


def should_promote(row, siblings):
    """A project fact earns global scope when the same statement (ignoring
    case and punctuation) is live in at least PROMOTE_MIN distinct projects,
    the candidate's own project included. Siblings that merely share a
    subject but say something else are not evidence."""
    agree = {s["scope"] for s in siblings if norm(s["text"]) == norm(row["text"])}
    agree.add(row["scope"])
    return len(agree) >= PROMOTE_MIN


# ---------------------------------------------------------------- pressure
# A dossier is a claim under test; touches are the evidence arriving since it
# was last written or reviewed. Only a people note or an explicit review
# resets the clock: an episodic note about a person raises pressure on the
# dossier, it never relieves it.

def hook_input():
    """The JSON a Claude Code hook gets on stdin, or {} at a terminal."""
    import json
    try:
        data = {} if sys.stdin.isatty() else json.load(sys.stdin)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def claim(c, session, cmd, source, served):
    """Once per session: the command hook and the function hook both serve
    wake and recall when CLAUDE_CODE_ENABLE_FUNCTION_HOOKS is on, in an
    order the engine does not promise. Whichever inserts the row first owns
    it; every path speaks only when it is the owner. Keyed on source so a
    compaction wakes again. Returns the owner's `served` value."""
    with c:
        c.execute("INSERT OR IGNORE INTO claims(session,cmd,source,served) "
                  "VALUES (?,?,?,?)", (session, cmd, source, served))
    return c.execute("SELECT served FROM claims WHERE session=? AND cmd=? AND source=?",
                     (session, cmd, source)).fetchone()[0]


def touch(c, entities, kind, session=""):
    rows = [(e.strip().lower(), kind, session) for e in entities if e.strip()]
    if rows:
        with c:
            c.executemany("INSERT INTO touches(entity,kind,session) VALUES (?,?,?)", rows)


def dossier_clock(c):
    """Entity -> when its dossier last met the evidence: the newest people
    note that tags it, or a later explicit review."""
    clock = {}
    for ts, ents in c.execute("SELECT ts, entities FROM memories WHERE kind='people'"):
        for e in ents.lower().split(","):
            if e.strip():
                clock[e.strip()] = max(clock.get(e.strip(), ""), ts)
    for e, ts in c.execute(
            "SELECT entity, MAX(ts) FROM touches WHERE kind='review' GROUP BY entity"):
        if e in clock:
            clock[e] = max(clock[e], ts)
    return clock


def dossier_pressure(c):
    """Weighted touches per entity since its clock, heaviest first."""
    out = []
    for e, since in dossier_clock(c).items():
        n = dict(c.execute("SELECT kind, COUNT(*) FROM touches WHERE entity=? AND ts>? "
                           "AND kind IN ('note','recall','prompt') GROUP BY kind", (e, since)))
        p = sum(TOUCH_WEIGHT[k] * v for k, v in n.items())
        if p:
            out.append((e, p, n, since))
    return sorted(out, key=lambda r: (-r[1], r[0]))


def note_clock(c, row):
    """When procedural note #id last met the evidence: its own write, or a
    later explicit review (touch by id)."""
    r = c.execute("SELECT MAX(ts) FROM touches WHERE kind='review' AND entity=?",
                  ("#%d" % row["id"],)).fetchone()
    return max(row["ts"], r[0] or "")


def note_pressure(c, scopes):
    """Weighted touches per live procedural note since its clock, heaviest
    first. Yields (row, pressure, counts, since, reviewed, kept): reviewed
    means it survived an earlier cycle; kept means the agent chose memory
    over the repo, so export is not suggested again."""
    out = []
    for row in live(c, "procedural", scopes):
        ents = sorted(entity_set(row))
        if not ents:
            continue
        since = note_clock(c, row)
        n = dict(c.execute(
            "SELECT kind, COUNT(*) FROM touches WHERE entity IN (%s) AND ts>=? "
            "AND kind IN ('note','recall','prompt') GROUP BY kind"
            % ",".join("?" * len(ents)), (*ents, since)))
        p = sum(TOUCH_WEIGHT[k] * v for k, v in n.items())
        if not p:
            continue
        r = c.execute("SELECT COUNT(*), COALESCE(SUM(session='keep'), 0) FROM touches "
                      "WHERE kind='review' AND entity=?", ("#%d" % row["id"],)).fetchone()
        out.append((row, p, n, since, r[0] > 0, r[1] > 0))
    return sorted(out, key=lambda t: (-t[1], t[0]["id"]))


def form_ladder(row):
    """The export target, strongest form first: knowledge compiled into
    enforcement needs no reader at all (WikiSkill, arXiv:2608.27454)."""
    if row["scope"] == GLOBAL:
        return "~/.claude/CLAUDE.md, or a personal skill"
    return ("the repo, strongest form that fits: enforcement (a config, a "
            "CI check, a lint rule), a skill, CLAUDE.md, then docs")


def fmt_counts(n):
    return ", ".join("%d %s%s" % (n[k], k, "" if n[k] == 1 else "s")
                     for k in ("note", "recall", "prompt") if n.get(k))


# ---------------------------------------------------------------- org layer
# Altitude 2 (ARCHITECTURE.md): a cloned knowledge repo of one-fact-per-file
# markdown, indexed read-only into a local cache. Never loaded whole at
# wake: recall and the prompt hook pull from it; wake surfaces only the
# summary line, conflicts, and co-sign nudges.

def org_dir():
    d = os.environ.get("SEGMEM_ORG_DIR")
    return os.path.abspath(os.path.expanduser(d)) if d else None


def org_head(d):
    try:
        return subprocess.check_output(["git", "-C", d, "rev-parse", "HEAD"],
                                       text=True, stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def parse_fact(path):
    """A fact file: --- fences, key: value lines, body is the claim."""
    try:
        raw = open(path, encoding="utf-8").read()
    except OSError:
        return None
    m = re.match(r"---\s*\n(.*?)\n---\s*\n(.*)", raw, re.S)
    if not m:
        return None
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip().lower()] = v.strip()
    text = " ".join(m.group(2).split())
    if not text:
        return None
    return {"kind": meta.get("kind", "procedural"), "scope": meta.get("scope", "org"),
            "entities": meta.get("entities", ""), "witnesses": meta.get("witnesses", ""),
            "supersedes": meta.get("supersedes", ""), "text": text}


def org_connect():
    """The cache for SEGMEM_ORG_DIR, rebuilt when the repo's HEAD moves.
    None when no org dir is configured. Read-only toward the repo."""
    d = org_dir()
    if not d or not os.path.isdir(d):
        return None
    import hashlib
    cache = os.path.join(os.path.dirname(db_path()),
                         "org-%s.db" % hashlib.sha1(d.encode()).hexdigest()[:12])
    oc = sqlite3.connect(cache, timeout=10)
    oc.row_factory = sqlite3.Row
    oc.executescript("""
CREATE TABLE IF NOT EXISTS org_facts (
  slug TEXT PRIMARY KEY, status TEXT, kind TEXT, scope TEXT,
  entities TEXT, witnesses TEXT, supersedes TEXT, text TEXT, path TEXT);
CREATE VIRTUAL TABLE IF NOT EXISTS org_fts USING fts5(slug UNINDEXED, text, entities);
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
""")
    head = org_head(d)
    cur = oc.execute("SELECT v FROM meta WHERE k='head'").fetchone()
    if cur is None or cur[0] != head or head == "":
        with oc:
            oc.execute("DELETE FROM org_facts")
            oc.execute("DELETE FROM org_fts")
            for status, sub in (("fact", "facts"), ("candidate", "candidates")):
                folder = os.path.join(d, sub)
                names = sorted(os.listdir(folder)) if os.path.isdir(folder) else []
                for name in names:
                    if not name.endswith(".md"):
                        continue
                    f = parse_fact(os.path.join(folder, name))
                    if not f:
                        continue
                    slug = name[:-3]
                    oc.execute("INSERT OR REPLACE INTO org_facts VALUES (?,?,?,?,?,?,?,?,?)",
                               (slug, status, f["kind"], f["scope"], f["entities"],
                                f["witnesses"], f["supersedes"], f["text"],
                                os.path.join(sub, name)))
                    oc.execute("INSERT INTO org_fts(slug, text, entities) VALUES (?,?,?)",
                               (slug, f["text"], f["entities"]))
            oc.execute("INSERT OR REPLACE INTO meta VALUES ('head', ?)", (head,))
    return oc


def org_live(oc):
    dead = {r[0] for r in oc.execute(
        "SELECT supersedes FROM org_facts WHERE supersedes != ''")}
    return [r for r in oc.execute("SELECT * FROM org_facts ORDER BY slug")
            if r["slug"] not in dead]


def org_search(oc, q, limit):
    dead = {r[0] for r in oc.execute(
        "SELECT supersedes FROM org_facts WHERE supersedes != ''")}
    try:
        rows = oc.execute(
            "SELECT f.* FROM org_fts JOIN org_facts f ON f.slug = org_fts.slug "
            "WHERE org_fts MATCH ? ORDER BY rank LIMIT ?",
            (q, limit + len(dead))).fetchall()
    except sqlite3.OperationalError:
        return []
    return [r for r in rows if r["slug"] not in dead][:limit]


def org_line(r, path=True):
    tags = " [%s]" % r["entities"] if r["entities"] else ""
    cand = " [candidate]" if r["status"] == "candidate" else ""
    tail = " (%s)" % r["path"] if path else ""
    return "org:%s (org)%s%s: %s%s" % (r["slug"], tags, cand, r["text"], tail)


# ---------------------------------------------------------------- commands

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def check_len(text):
    n = len(text.encode())
    if n <= MAX_BYTES:
        return
    keep = text.encode()[:MAX_BYTES].decode("utf-8", "ignore")
    die("Too long: %d bytes, max %d. The mark is where the limit falls; "
        "trim the tail, don't rewrite:\n%s▮%s" % (n, MAX_BYTES, keep, text[len(keep):]))


def flags(args):
    """Split `--k=v` flags from positionals."""
    opts, pos = {}, []
    for a in args:
        if a.startswith("--") and "=" in a:
            k, v = a[2:].split("=", 1)
            opts[k] = v
        elif a.startswith("--"):
            opts[a[2:]] = "1"
        else:
            pos.append(a)
    return opts, pos


def known_tags(c):
    """Every tag ever written, keyed by lowercase, valued by stored spelling.
    One vocabulary across scopes: promotion matches siblings by tag."""
    tags = {}
    for (ents,) in c.execute("SELECT entities FROM memories WHERE entities != ''"):
        for e in ents.split(","):
            e = e.strip()
            if e:
                tags.setdefault(e.lower(), e)
    return tags


def canon(c, raw, kind, scope=GLOBAL):
    """Trim and dedupe tags; a tag that matches a known one ignoring case
    takes the stored spelling. Returns (entities, hints): hints name a new
    tag's near matches, and a name-like tag with no people record."""
    tags, out, seen, hints = known_tags(c), [], set(), []
    people = {e for (ents,) in c.execute("SELECT entities FROM memories WHERE kind='people'")
              for e in ents.lower().split(",") if e.strip()}
    import difflib
    for e in raw.split(","):
        e = e.strip()
        k = e.lower()
        if not e or k in seen:
            continue
        seen.add(k)
        if scope != GLOBAL and k == short(scope).lower():
            hints.append("tag %s is the scope itself and was dropped; tag the subject "
                         "(a component, file, or person) instead" % e)
            continue
        if k in tags:
            out.append(tags[k])
            continue
        out.append(e)
        near = difflib.get_close_matches(k, list(tags), n=3, cutoff=0.8)
        if near:
            hints.append("new tag: %s (similar: %s)" % (e, ", ".join(tags[n] for n in near)))
    if kind != "people":
        for e in out:
            if re.fullmatch(r"[A-Z][a-z]+", e) and e.lower() not in people:
                hints.append("no people record for %s; if a person: %s note people "
                             "\"<who they are>\" --entities=%s" % (e, ME, e))
    return ",".join(out), hints


def note_scope(opts, kind):
    """Where a note lands: --scope as given, else global for the kinds that
    are about a person and the project for the kinds that are about work."""
    default = GLOBAL if kind in ("identity", "people") else project()
    return {"global": GLOBAL, "project": project()}.get(opts.get("scope"), None) \
        or opts.get("scope") or default


NOTE_USAGE = ("usage: %s note <%s> \"<text>\" [--scope=global|project] "
              "[--entities=a,b] [--supersedes=id]")


def cmd_note(c, args):
    opts, pos = flags(args)
    if len(pos) != 2 or pos[0] not in KINDS:
        die(NOTE_USAGE % (ME, "|".join(KINDS)))
    kind, text = pos
    text = " ".join(text.split())
    check_len(text)
    scope = note_scope(opts, kind)
    sup = int(opts["supersedes"]) if "supersedes" in opts else None
    if sup is not None and not c.execute("SELECT 1 FROM memories WHERE id=?", (sup,)).fetchone():
        die("No memory #%d to supersede." % sup)
    entities, hints = canon(c, opts.get("entities", ""), kind, scope)
    with c:
        seq = stream_len(c, kind, scope)
        c.execute("INSERT INTO memories(kind,scope,seq,entities,supersedes,text) "
                  "VALUES (?,?,?,?,?,?)",
                  (kind, scope, seq, entities, sup, text))
        rid = c.execute("SELECT last_insert_rowid()").fetchone()[0]
    print("#%d %s %s" % (rid, kind, "(%s)" % short(scope)))
    for h in hints + scope_hints(c, entities, scope, rid):
        print(h)
    if kind != "people":
        # a people note is the dossier revision itself, not evidence against it
        touch(c, entities.split(","), "note")
    nap = next_nap(c, project())
    if nap:
        print("\n" + nap[1])


def cmd_check_note(c, args):
    """A Bash command about to run, whole, on stdin. When it invokes
    `segmem note`, run the checks the real note runs and write nothing: a
    line that would be refused exits 1 with the trim mark or the usage, and
    one that would only be warned about exits 0 with the hints. Any other
    command is silence and exit 0, so the shell runs as it always did.

    The function hook calls this before the Bash tool, which turns a note
    the model would have to retry into one it never sends."""
    import shlex
    try:
        toks = shlex.split("" if sys.stdin.isatty() else sys.stdin.read())
    except ValueError:
        return              # quoting this parser cannot read: never block on a guess
    at = next((i for i, t in enumerate(toks)
               if os.path.basename(t) == os.path.basename(ME)
               and toks[i + 1:i + 2] == ["note"]), None)
    if at is None:
        return
    opts, pos = flags(toks[at + 2:])
    if len(pos) != 2 or pos[0] not in KINDS:
        die(NOTE_USAGE % (ME, "|".join(KINDS)))
    kind, text = pos
    check_len(" ".join(text.split()))
    _, hints = canon(c, opts.get("entities", ""), kind, note_scope(opts, kind))
    for h in hints:
        print(h)


def scope_hints(c, entities, scope, rid):
    """A tag whose whole history lives in another project marks a likely
    misfile: recall searches only cwd's project plus global, so a wrong-scoped
    note is invisible to exactly the sessions that need it."""
    if scope == GLOBAL or not entities:
        return []
    lived = {}
    for r in c.execute("SELECT scope, entities FROM memories WHERE entities!='' AND id!=?",
                       (rid,)):
        for e in entity_set(r):
            lived.setdefault(e, set()).add(r["scope"])
    hints = []
    for e in entities.lower().split(","):
        others = lived.get(e.strip(), set()) - {GLOBAL}
        if others and scope not in others:
            hints.append("prior notes about %s live in %s, not %s; misfiled? %s forget %d, "
                         "then re-note from the right repo or with --scope=<path>"
                         % (e.strip(), ", ".join(sorted(short(s) for s in others)),
                            short(scope), ME, rid))
    return hints


def short(scope):
    return scope if scope == GLOBAL else os.path.basename(scope)


def cmd_nap(c, args):
    if len(args) != 2 or not re.fullmatch(r"\d+-\d+", args[0]):
        die("usage: %s nap <lo>-<hi> \"<line>\"" % ME)
    lo, hi = (int(x) for x in args[0].split("-"))
    hi += 1
    text = " ".join(args[1].split())
    check_len(text)
    nap = next_nap(c, project())
    if not nap:
        die("Nothing to compress.")
    scope = nap[0]
    with c:
        c.execute("INSERT OR REPLACE INTO summaries(kind,scope,lo,hi,text) VALUES (?,?,?,?,?)",
                  ("episodic", scope, lo, hi, text))
    nap = next_nap(c, project())
    print(nap[1] if nap else "All compressed.")


def cmd_forget(c, args):
    if len(args) != 1 or not re.fullmatch(r"\d+(-\d+)?", args[0]):
        die("usage: %s forget <id> | <lo>-<hi>   (a misfiled note by id, or a summary block)" % ME)
    if "-" in args[0]:
        lo, hi = (int(x) for x in args[0].split("-"))
        with c:
            n = c.execute("DELETE FROM summaries WHERE kind='episodic' AND scope=? AND lo=? AND hi=?",
                          (project(), lo, hi + 1)).rowcount
        print("Dropped %d summary." % n if n else "No such summary.")
        return
    rid = int(args[0])
    row = c.execute("SELECT * FROM memories WHERE id=?", (rid,)).fetchone()
    if not row:
        die("No memory #%d." % rid)
    # A hole mid-stream would break the episodic tree, whose blocks index by
    # seq; other kinds load whole and tolerate gaps.
    if row["kind"] == "episodic" and row["seq"] != stream_len(c, "episodic", row["scope"]) - 1:
        die("#%d is not the newest episodic note in %s; supersede it instead."
            % (rid, short(row["scope"])))
    ref = c.execute("SELECT id FROM memories WHERE supersedes=?", (rid,)).fetchone()
    if ref:
        die("#%d is superseded by #%d; forget that one first." % (rid, ref["id"]))
    with c:
        c.execute("INSERT INTO memories_fts(memories_fts, rowid, text, entities) "
                  "VALUES ('delete', ?, ?, ?)", (rid, row["text"], row["entities"]))
        c.execute("DELETE FROM memories WHERE id=?", (rid,))
        if row["kind"] == "episodic":
            # summaries that covered the deleted row describe rows that no
            # longer exist; drop them, the tree rebuilds on request
            c.execute("DELETE FROM summaries WHERE kind='episodic' AND scope=? AND hi>?",
                      (row["scope"], row["seq"]))
    print("Forgot #%d (%s, %s)." % (rid, row["kind"], short(row["scope"])))
    if row["supersedes"]:
        print("#%d is live again." % row["supersedes"])


def cmd_recall(c, args):
    if not args:
        die("usage: %s recall <query>   (FTS5 syntax; searches every scope and kind)" % ME)
    q = " ".join(a for a in args if a != "--all")
    if not q:
        die("usage: %s recall <query> [--all]" % ME)
    sql = ("SELECT m.* FROM memories_fts f JOIN memories m ON m.id=f.rowid "
           "WHERE memories_fts MATCH ? ORDER BY rank LIMIT 50")
    try:
        rows = c.execute(sql, (q,)).fetchall()
    except sqlite3.OperationalError:
        # FTS5 reads a bare hyphen or colon as syntax ("no such column: op"
        # for mem-op). Retry with terms quoted, keeping the operators.
        q = " ".join(t if t in ("OR", "AND", "NOT") else '"%s"' % t.replace('"', '""')
                     for t in q.split())
        try:
            rows = c.execute(sql, (q,)).fetchall()
        except sqlite3.OperationalError as e:
            die("Bad query: %s" % e)
    oc = org_connect()
    orows = org_search(oc, q, HOOK_MAX) if oc else []
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    show_all = "--all" in args
    if not show_all:
        # Superseded rows are history, not answers; the cwd's project and
        # global rank above other projects; FTS rank orders within.
        alive = [r for r in rows if r["id"] not in dead]
        rows = alive or rows          # only history matched: show it, flagged
        near = {GLOBAL, project()}
        rows.sort(key=lambda r: r["scope"] not in near)
    more = max(0, len(rows) - RECALL_MAX) if not show_all else 0
    rows = rows[:len(rows) - more]
    if not rows and not orows:
        print("No match.")
        return
    for r in rows:
        flag = " [superseded]" if r["id"] in dead else ""
        tags = " [%s]" % r["entities"] if r["entities"] else ""
        print("#%d %s %s %s%s%s: %s" % (r["id"], r["ts"][:10], r["kind"], short(r["scope"]),
                                        tags, flag, r["text"]))
    for r in orows:
        print(org_line(r))
    if more:
        print("(%d more; %s recall --all %s)" % (more, ME, q))
    touch(c, {e for r in rows for e in entity_set(r)}, "recall")


def cmd_touch(c, args):
    opts, pos = flags(args)
    if len(pos) != 1:
        die("usage: %s touch <entity|id> [--keep]   (reviewed, unchanged; resets pressure)" % ME)
    if pos[0].isdigit():
        row = c.execute("SELECT * FROM memories WHERE id=? AND %s" % LIVE,
                        (int(pos[0]),)).fetchone()
        if not row or row["kind"] != "procedural":
            die("No live procedural note #%s." % pos[0])
        # 'keep' rides in the free-text session column: the touches CHECK
        # constraint predates it, and a table rebuild isn't worth one flag.
        touch(c, ["#%d" % row["id"]], "review", "keep" if "keep" in opts else "")
        print('Reviewed #%d unchanged: "%s"%s' % (
            row["id"], row["text"],
            "; kept in memory, export will not be suggested again." if "keep" in opts
            else ". The next real change still needs a supersede."))
        return
    if "keep" in opts:
        die("--keep applies to a procedural note id.")
    e = pos[0].strip().lower()
    if e not in dossier_clock(c):
        die("No people note tags %s." % pos[0])
    prow = None
    for r in c.execute("SELECT * FROM memories WHERE kind='people' AND %s ORDER BY id" % LIVE):
        if e in entity_set(r):
            prow = r
    touch(c, [e], "review")
    print('Reviewed %s unchanged: "%s". The next real change still needs a supersede.'
          % (e, prow["text"]))


def cmd_stale(c, args):
    opts, _ = flags(args)
    dmin = int(opts.get("min", STALE_MIN))
    pmin = int(opts.get("min", PROC_STALE_MIN))
    due = [r for r in dossier_pressure(c) if r[1] >= dmin]
    pdue = [r for r in note_pressure(c, [project(), GLOBAL]) if r[1] >= pmin]
    if "count" in opts:
        # for a status line: how many subjects are due, and nothing else
        print(len(due) + len(pdue))
        return
    if "hook" in opts:
        return stale_hook(c, due, pdue)
    if not due and not pdue:
        print("No dossier under pressure (threshold %d)." % dmin)
        return
    for e, p, n, since in due:
        print("%s: pressure %d (%s) since %s. Supersede its people note or: %s touch %s"
              % (e, p, fmt_counts(n), since[:10], ME, e))
    for row, p, n, since, reviewed, kept in pdue:
        if reviewed and not kept:
            print('#%d stable and hot: pressure %d (%s) since %s: "%s". Compile it '
                  "into %s. Then supersede #%d with a pointer, or: %s touch %d --keep"
                  % (row["id"], p, fmt_counts(n), since[:10], row["text"],
                     form_ladder(row), row["id"], ME, row["id"]))
        else:
            print('#%d procedural: pressure %d (%s) since %s: "%s". Verify against the '
                  "repo, then supersede or: %s touch %d"
                  % (row["id"], p, fmt_counts(n), since[:10], row["text"], ME, row["id"]))


def stale_hook(c, due, pdue):
    """Claude Code Stop hook: when a dossier or a procedural fact is under
    pressure, block the stop once per subject and session so a live agent
    reviews it. stop_hook_active means this stop is already the result of a
    block: let it through."""
    import json
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not isinstance(data, dict) or data.get("stop_hook_active"):
        return
    sid = data.get("session_id", "")
    nagged = {e for (e,) in c.execute(
        "SELECT DISTINCT entity FROM touches WHERE kind='nag' AND session=?", (sid,))}
    due = [r for r in due if r[0] not in nagged]
    pdue = [r for r in pdue if "#%d" % r[0]["id"] not in nagged]
    if not due and not pdue:
        return
    touch(c, [e for e, _, _, _ in due] + ["#%d" % r[0]["id"] for r in pdue], "nag", sid)
    parts = []
    if due:
        names = "; ".join("%s (%s since %s)" % (e, fmt_counts(n), since[:10])
                          for e, p, n, since in due)
        parts.append("Dossiers under pressure: %s. For each: supersede the people note "
                     "with what changed, or confirm it unchanged with `%s touch <entity>`."
                     % (names, ME))
    verify = [r for r in pdue if not (r[4] and not r[5])]
    export = [r for r in pdue if r[4] and not r[5]]
    if verify:
        parts.append("Procedural facts under pressure: %s. Verify each against the repo, "
                     "then supersede what changed or confirm with `%s touch <id>`."
                     % ("; ".join('#%d \"%s\"' % (r[0]["id"], r[0]["text"][:60])
                                  for r in verify), ME))
    if export:
        parts.append("Stable and hot, compile into the repo: %s. Strongest form that "
                     "fits: enforcement (a config, a CI check, a lint rule), a skill, "
                     "CLAUDE.md, then docs (~/.claude/CLAUDE.md for global facts). "
                     "Supersede each note with a pointer, or keep it in memory with "
                     "`%s touch <id> --keep`."
                     % ("; ".join('#%d \"%s\"' % (r[0]["id"], r[0]["text"][:60])
                                  for r in export), ME))
    parts.append("Keep hedges as hedges when you supersede.")
    print(json.dumps({"decision": "block", "reason": " ".join(parts)}))


def cmd_promote(c, args):
    if len(args) != 1 or not args[0].isdigit():
        die("usage: %s promote <id>" % ME)
    row = c.execute("SELECT * FROM memories WHERE id=?", (int(args[0]),)).fetchone()
    if not row or row["scope"] == GLOBAL or row["kind"] not in ("identity", "procedural"):
        die("Only a project-scoped identity or procedural memory can be promoted.")
    ents = entity_set(row)
    siblings = [s for s in live(c, row["kind"], _other_scopes(c, row["scope"]))
                if ents & entity_set(s)]
    if not should_promote(row, siblings):
        print("Not promoted: seen in %d other project%s." % (len(siblings), "" if len(siblings) == 1 else "s"))
        return
    with c:
        seq = stream_len(c, row["kind"], GLOBAL)
        c.execute("INSERT INTO memories(kind,scope,seq,entities,text) VALUES (?,?,?,?,?)",
                  (row["kind"], GLOBAL, seq, row["entities"],
                   "%s (promoted from #%d)" % (row["text"], row["id"])))
    print("Promoted #%d to global." % row["id"])


def _other_scopes(c, scope):
    return [r[0] for r in c.execute(
        "SELECT DISTINCT scope FROM memories WHERE scope NOT IN (?,?)", (scope, GLOBAL))]


def cmd_contribute(c, args):
    """Print the org-repo candidate for a procedural fact: the file, its
    path, and the commands to open the PR. segmem never writes the repo."""
    if len(args) != 1 or not args[0].isdigit():
        die("usage: %s contribute <id>   (procedural facts only)" % ME)
    row = c.execute("SELECT * FROM memories WHERE id=? AND %s" % LIVE,
                    (int(args[0]),)).fetchone()
    if not row or row["kind"] != "procedural":
        die("No live procedural note #%s. Identity, people, and raw episodic "
            "notes never leave the device; a decision exits as an ADR in its "
            "project repo." % args[0])
    people = {e for (ents,) in c.execute("SELECT entities FROM memories WHERE kind='people'")
              for e in ents.lower().split(",") if e.strip()}
    named = entity_set(row) & people
    if named:
        die("Not contributable: entity %s names a person. Facts about people "
            "never leave the device." % ", ".join(sorted(named)))
    try:
        who = subprocess.check_output(["git", "config", "user.name"],
                                      text=True, stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        who = "unknown"
    today = c.execute("SELECT date('now')").fetchone()[0]
    witness = "%s %s %s" % (who, today, short(row["scope"]))
    oc = org_connect()
    if oc:
        for r in oc.execute("SELECT * FROM org_facts"):
            if norm(r["text"]) == norm(row["text"]):
                if r["status"] == "fact":
                    print("Already in the org layer: %s. Nothing to contribute." % r["path"])
                else:
                    print("Candidate %s already carries this claim. Co-sign it: in a PR, "
                          "append to the witnesses line of %s:\n  ; %s"
                          % (r["slug"], r["path"], witness))
                return
    ents = [e.strip() for e in row["entities"].split(",") if e.strip()]
    slug = "-".join(([ents[0].lower()] if ents else [])
                    + norm(row["text"]).split()[:4])[:60].strip("-")
    d = org_dir() or "<knowledge-repo>"
    print("""Candidate for the org layer. Review it, then run the commands.

cd %s
git switch -c fact/%s
cat > candidates/%s.md <<'FACT'
---
kind: procedural
scope: org
entities: %s
witnesses: %s
---
%s
FACT
git add candidates/%s.md && git commit -m "candidate: %s"
gh pr create --title "candidate: %s" --body "First witness: %s (%s). Merges to facts/ at %d witnesses."

Then supersede #%d locally with a pointer once it merges.""" % (
        d, slug, slug, ", ".join(ents), witness, row["text"], slug, slug,
        slug, who, short(row["scope"]), PROMOTE_MIN, row["id"]))


def cmd_org_init(c, args):
    """Scaffold a knowledge repo: the witnessing convention, ready to git
    init. Explicitly user-invoked, the one place segmem writes files."""
    if len(args) != 1:
        die("usage: %s org-init <dir>   (scaffold a knowledge repo)" % ME)
    d = os.path.abspath(os.path.expanduser(args[0]))
    if os.path.isdir(d) and os.listdir(d):
        die("Not empty: %s" % d)
    os.makedirs(os.path.join(d, "facts"), exist_ok=True)
    os.makedirs(os.path.join(d, "candidates"), exist_ok=True)
    open(os.path.join(d, "README.md"), "w").write("""\
# Knowledge repo

One fact per file. `candidates/` holds claims with fewer than three
witnesses; a candidate merges to `facts/` when three independent stores
co-sign, a witness line each. CODEOWNERS names the human on the other end
of every staleness signal: when someone's local memory contradicts a fact
here, they open an issue on the fact's file, and its owner decides.

File format:

    ---
    kind: procedural
    scope: org
    entities: aws, lambda
    witnesses: alice 2026-08-12 kerf; bob 2026-08-20 bearing
    supersedes: old-slug
    ---
    The claim, one line, under 280 bytes.

Facts are claims from when they were written. Supersede, never edit;
delete only misfiles. Never facts about people.
""")
    open(os.path.join(d, "CODEOWNERS"), "w").write("""\
# The named human on the other end of the staleness signal.
# facts/aws-*.md @platform-team
* @OWNER
""")
    open(os.path.join(d, "facts", "knowledge-repo.md"), "w").write("""\
---
kind: procedural
scope: org
entities: knowledge-repo
witnesses: segmem %s org-init
---
This repo holds org facts; candidates merge at three witnesses. See README.
""" % c.execute("SELECT date('now')").fetchone()[0])
    print("Scaffolded %s.\nNext:\n  cd %s && git init && git add -A && "
          "git commit -m 'org: init'\n  export SEGMEM_ORG_DIR=%s" % (d, d, d))


def cmd_wake(c, args):
    opts, _ = flags(args)
    if "once" in opts:
        data = {} if "session" in opts else hook_input()
        sid = opts.get("session") or data.get("session_id", "")
        src = opts.get("source") or data.get("source", "startup")
        served = opts.get("served", "command")
        if sid and claim(c, sid, "wake", src, served) != served:
            return          # the other hook path owns this session's wake
    p = project()
    scopes = [GLOBAL] if p == GLOBAL else [GLOBAL, p]
    out = ["## Memory (project: %s)" % short(p)]
    conflicts = []          # for --conflicts: the id pairs, without the prose

    for kind, title in (("identity", "Identity"), ("procedural", "Procedural")):
        rows = live(c, kind, scopes)
        if not rows:
            continue
        out.append("\n### %s" % title)
        glob = [r for r in rows if r["scope"] == GLOBAL]
        proj = [r for r in rows if r["scope"] != GLOBAL]
        # Conflict: a project row sharing a subject with a global row. Project
        # wins, and both are shown so the agent sees why.
        conflicted = set()
        for pr in proj:
            for g in glob:
                if entity_set(pr) & entity_set(g):
                    conflicted.update((pr["id"], g["id"]))
                    out.append("#%d %s (global) OVERRIDDEN by #%d %s (%s)"
                               % (g["id"], g["text"], pr["id"], pr["text"], short(p)))
                    conflicts.append("#%d overrides #%d" % (pr["id"], g["id"]))
        shown = [r for r in rows if r["id"] not in conflicted]
        hidden = 0
        if kind == "procedural" and len(shown) > WAKE_PROCEDURAL and "--all" not in args:
            hidden, shown = len(shown) - WAKE_PROCEDURAL, shown[-WAKE_PROCEDURAL:]
        for r in shown:
            out.append("#%d %s (%s)" % (r["id"], r["text"], short(r["scope"])))
        if hidden:
            out.append("(%d older procedural notes not printed; recall and the prompt hook "
                       "still find them, or: %s wake --all)" % (hidden, ME))
        if kind == "procedural":
            for row, p2, n2, since, reviewed, kept in note_pressure(c, scopes):
                if p2 < PROC_STALE_MIN:
                    continue
                if reviewed and not kept:
                    out.append("#%d is stable and hot (%s since %s): compile it into the repo "
                               "(enforce > skill > CLAUDE.md > docs) and supersede with a "
                               "pointer, or: %s touch %d --keep"
                               % (row["id"], fmt_counts(n2), since[:10], ME, row["id"]))
                else:
                    out.append("#%d under pressure (%s since %s): verify against the repo, "
                               "then supersede or: %s touch %d"
                               % (row["id"], fmt_counts(n2), since[:10], ME, row["id"]))

    oc = org_connect()
    if oc:
        ofacts = org_live(oc)
        n_cand = sum(1 for r in ofacts if r["status"] == "candidate")
        head = (oc.execute("SELECT v FROM meta WHERE k='head'").fetchone() or [""])[0]
        out.append("\n### Org layer: %d facts (%d candidates)%s; recall searches them."
                   % (len(ofacts) - n_cand, n_cand, " @ %s" % head[:7] if head else ""))
        loc = live(c, "identity", scopes) + live(c, "procedural", scopes)
        for of in ofacts:
            oe = {e.strip().lower() for e in of["entities"].split(",") if e.strip()}
            if of["status"] == "fact":
                # The contradiction report: a nearer fact beating an org fact
                # is the org layer's staleness signal (ARCHITECTURE.md).
                for lr in loc:
                    if oe & entity_set(lr):
                        out.append("org:%s %s (org) OVERRIDDEN by #%d %s (%s); if the "
                                   "org fact is wrong, open an issue on %s"
                                   % (of["slug"], of["text"], lr["id"], lr["text"],
                                      short(lr["scope"]), of["path"]))
                        conflicts.append("#%d overrides org:%s" % (lr["id"], of["slug"]))
                        break
            else:
                for lr in loc:
                    if lr["kind"] == "procedural" and norm(lr["text"]) == norm(of["text"]):
                        out.append("your #%d matches candidate %s: co-sign it (add a "
                                   "witness line to %s via PR)"
                                   % (lr["id"], of["slug"], of["path"]))
                        break

    people = live(c, "people", scopes)
    if people:
        names = {}
        for r in people:
            for e in r["entities"].split(","):
                if e.strip():
                    names.setdefault(e.strip().lower(), e.strip())
        out.append("\n### People known: %s" % ", ".join(names[k] for k in sorted(names)))
        out.append("Run `%s recall <name>` before acting on or about them." % ME)
        for e, pe, n, since in dossier_pressure(c):  # not p: that is the project
            if pe >= STALE_MIN and e in names:
                out.append("%s: dossier from %s, %s since. Supersede it or, if unchanged: "
                           "%s touch %s" % (names[e], since[:10], fmt_counts(n), ME, e))

    streams = [(GLOBAL, WAKE_EPISODIC)] if p == GLOBAL else \
        [(p, WAKE_EPISODIC), (GLOBAL, WAKE_EPISODIC_GLOBAL)]
    for sc, budget in streams:
        T = stream_len(c, "episodic", sc)
        if not T:
            continue
        out.append("\n### Episodic (%s), oldest first" % short(sc))
        for lo, hi in cover(T, budget):
            if hi - lo == 1:
                r = c.execute("SELECT ts, text FROM memories WHERE kind='episodic' AND scope=? AND seq=?",
                              (sc, lo)).fetchone()
                out.append("#%d %s %s" % (lo, r[0][:10], r[1]))
            else:
                s = summary(c, "episodic", sc, lo, hi)
                if s is None:
                    # Not compressed yet: wake never blocks. Print the block
                    # raw and let next_nap ask for one compression below.
                    out.append("#%d-%d %s (not compressed yet)" % (lo, hi - 1, span(c, sc, lo, hi)))
                    for r in c.execute("SELECT seq, ts, text FROM memories WHERE kind='episodic' "
                                       "AND scope=? AND seq>=? AND seq<? ORDER BY seq", (sc, lo, hi)):
                        out.append("  #%d %s %s" % (r[0], r[1][:10], r[2]))
                    continue
                out.append("#%d-%d %s %s" % (lo, hi - 1, span(c, sc, lo, hi), s))
    if "conflicts" in opts:
        # For a hook that wants the contradictions as data, not as prose: one
        # id pair per line, nothing else, and no claim, since showing them is
        # not serving the session's memory.
        print("\n".join(conflicts))
        return
    print("\n".join(out))
    print("\nYou are awake.")
