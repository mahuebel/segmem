# ---------------------------------------------------------------- serve
# A live page over the store: stdlib http.server, loopback only, foreground
# (Ctrl-C stops it). Read-only: every route is a SELECT, and search skips the
# touch() that recall performs, so browsing never presses on a fact. Nothing
# in the hot path depends on it, so the no-daemon promise holds.

SERVE_PORT = 7878


def parse_query(q):
    """Split a ledger query into (fts_terms, filters).

    TODO(Mark): the chip grammar is yours. Today the whole string goes to
    FTS5 and filters arrive only from facet clicks (?kind= ?scope= ?entity=).
    Decide what a typed `scope:kerf`, `kind:procedural`, `since:7d`, or
    `superseded:yes` should mean, and return them in `filters` under the
    keys serve_search() already reads: kind, scope (full path or short
    name), entity, since (ISO date prefix, so "7d" needs converting), dead
    ("1" shows superseded rows). Words that are not chips stay in the FTS
    string; an empty FTS string lists newest first.
    """
    return q.strip(), {}


def fts_rows(c, sql, terms, params):
    """Run an FTS5 MATCH, retrying with quoted terms as recall does."""
    try:
        return c.execute(sql, (terms, *params)).fetchall()
    except sqlite3.OperationalError:
        quoted = " ".join(t if t in ("OR", "AND", "NOT") else '"%s"' % t.replace('"', '""')
                          for t in terms.split())
        return c.execute(sql, (quoted, *params)).fetchall()


def serve_search(c, q, f):
    import time
    t0 = time.time()
    terms, chips = parse_query(q)
    f = {**f, **chips}
    where, params = [], []
    if f.get("kind"):
        where.append("m.kind=?")
        params.append(f["kind"])
    if f.get("scope"):
        where.append("(m.scope=? OR m.scope LIKE ?)")
        params.extend((f["scope"], "%/" + f["scope"]))
    if f.get("entity"):
        where.append("(','||lower(m.entities)||',') LIKE ?")
        params.append("%%,%s,%%" % f["entity"].lower())
    if f.get("since"):
        where.append("m.ts>=?")
        params.append(f["since"])
    if f.get("dead") != "1":
        where.append("m.id NOT IN (SELECT supersedes FROM memories WHERE supersedes IS NOT NULL)")
    tail = "".join(" AND " + w for w in where)
    if terms:
        sql = ("SELECT m.* FROM memories_fts x JOIN memories m ON m.id=x.rowid "
               "WHERE memories_fts MATCH ?%s ORDER BY rank" % tail)
        try:
            rows = fts_rows(c, sql, terms, params)
        except sqlite3.OperationalError as e:
            return {"error": "Bad query: %s" % e, "rows": [], "total": 0, "facets": {}, "ms": 0}
    else:
        rows = c.execute("SELECT m.* FROM memories m WHERE 1%s ORDER BY m.id DESC" % tail,
                         params).fetchall()
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    facets = {"kind": {}, "scope": {}, "entity": {}}
    for r in rows:
        facets["kind"][r["kind"]] = facets["kind"].get(r["kind"], 0) + 1
        facets["scope"][r["scope"]] = facets["scope"].get(r["scope"], 0) + 1
        for e in entity_set(r):
            facets["entity"][e] = facets["entity"].get(e, 0) + 1
    facets["entity"] = dict(sorted(facets["entity"].items(), key=lambda kv: (-kv[1], kv[0]))[:14])
    out = [dict(r, dead=r["id"] in dead) for r in rows[:200]]
    return {"rows": out, "total": len(rows), "facets": facets, "filters": f,
            "ms": round((time.time() - t0) * 1000, 1)}


def serve_fact(c, rid):
    """One memory with everything the inspector shows: touches and pressure
    since its clock, the verdict wake would print, overrides, history."""
    row = c.execute("SELECT * FROM memories WHERE id=?", (rid,)).fetchone()
    if not row:
        return None
    d = dict(row)
    ents = sorted(entity_set(row))
    d["entities_list"] = ents
    nxt = c.execute("SELECT id, ts, text FROM memories WHERE supersedes=?", (rid,)).fetchone()
    d["superseded_by"] = dict(nxt) if nxt else None
    d["dead"] = nxt is not None
    prev = None
    if row["supersedes"]:
        prev = c.execute("SELECT id, ts, text FROM memories WHERE id=?", (row["supersedes"],)).fetchone()
    d["replaces"] = dict(prev) if prev else None
    d["total_in_stream"] = stream_len(c, row["kind"], row["scope"])

    since = note_clock(c, row) if row["kind"] == "procedural" else row["ts"]
    n, last = {}, None
    if ents:
        n = dict(c.execute(
            "SELECT kind, COUNT(*) FROM touches WHERE entity IN (%s) AND ts>=? "
            "AND kind IN ('note','recall','prompt') GROUP BY kind"
            % ",".join("?" * len(ents)), (*ents, since)))
        last = c.execute("SELECT MAX(ts) FROM touches WHERE entity IN (%s)"
                         % ",".join("?" * len(ents)), ents).fetchone()[0]
    d.update(touches=n, since=since, last_touch=last,
             pressure=sum(TOUCH_WEIGHT[k] * v for k, v in n.items()))
    r = c.execute("SELECT COUNT(*), COALESCE(SUM(session='keep'), 0) FROM touches "
                  "WHERE kind='review' AND entity=?", ("#%d" % rid,)).fetchone()
    reviewed, kept = r[0] > 0, r[1] > 0
    d["threshold"] = d["verdict"] = d["ladder"] = None
    d["hot"] = False
    if row["kind"] == "procedural":
        d["threshold"] = PROC_STALE_MIN
        d["ladder"] = form_ladder(row)
        if kept:
            d["verdict"] = "Kept: you chose memory over the repo, so export is not suggested again."
        elif d["pressure"] >= PROC_STALE_MIN and reviewed:
            d["hot"] = True
            d["verdict"] = ("Stable and hot: reviewed once and still pressed on. Compile it into "
                            "the repo and supersede with a pointer, or touch --keep.")
        elif d["pressure"] >= PROC_STALE_MIN:
            d["hot"] = True
            d["verdict"] = "Under pressure: verify against the repo, then supersede or touch."
        else:
            d["verdict"] = "Quiet: below the threshold since its last review."
    elif row["kind"] == "people":
        d["threshold"] = STALE_MIN
        d["hot"] = d["pressure"] >= STALE_MIN
        d["verdict"] = ("Dossier under pressure: supersede it or touch the name."
                        if d["hot"] else "Dossier current.")

    # Same-kind live facts in another scope that share a subject: the
    # OVERRIDDEN pairs wake prints, seen from either side.
    d["conflicts"] = []
    if row["kind"] in ("identity", "procedural") and ents:
        for o in c.execute("SELECT * FROM memories WHERE kind=? AND scope<>? AND %s" % LIVE,
                           (row["kind"], row["scope"])):
            if entity_set(o) & set(ents):
                d["conflicts"].append({"id": o["id"], "scope": o["scope"], "text": o["text"]})
    if d["dead"]:
        d["why"] = "It does not print: superseded by #%d." % nxt["id"]
    elif row["kind"] == "episodic":
        d["why"] = ("Episodic seq %d of %d in %s. It prints while the wake cover keeps it as a "
                    "leaf; once a nap folds it into a summary, the summary prints instead."
                    % (row["seq"], d["total_in_stream"], short(row["scope"])))
    elif row["kind"] == "people":
        d["why"] = "People notes never print whole; wake lists the name, recall returns the text."
    elif d["conflicts"] and row["scope"] == GLOBAL:
        d["why"] = ("Global fact. In %s it is OVERRIDDEN by #%d, and wake shows both so the agent "
                    "sees why." % (", ".join(short(x["scope"]) for x in d["conflicts"]),
                                   d["conflicts"][0]["id"]))
    elif d["conflicts"]:
        d["why"] = ("Live in %s and overrides #%d (%s) on a shared subject; wake prints the pair."
                    % (short(row["scope"]), d["conflicts"][0]["id"], short(d["conflicts"][0]["scope"])))
    else:
        d["why"] = ("Live in %s; no fact in another scope shares a subject, so nothing overrides it."
                    % short(row["scope"]))
    return d


def serve_feed(c, limit=40):
    rows = c.execute(
        "SELECT ts, 'touch' AS ev, entity AS a, kind AS b, session AS d, NULL AS id, NULL AS sup "
        "FROM touches UNION ALL "
        "SELECT ts, 'note', entities, kind, scope, id, supersedes FROM memories "
        "ORDER BY ts DESC LIMIT ?", (limit,)).fetchall()
    return [dict(r) for r in rows]


def serve_state(c, scope, lock):
    scopes = [{"scope": r[0], "n": r[1]} for r in
              c.execute("SELECT scope, COUNT(*) FROM memories GROUP BY scope ORDER BY 2 DESC")]
    if not scope:
        scope = project()
    with lock:  # cmd_wake reads the scope from the environment
        old = os.environ.get("SEGMEM_PROJECT")
        os.environ["SEGMEM_PROJECT"] = scope
        try:
            wake = capture(cmd_wake, [])
        finally:
            if old is None:
                os.environ.pop("SEGMEM_PROJECT", None)
            else:
                os.environ["SEGMEM_PROJECT"] = old
    seq = {}
    for r in c.execute("SELECT scope, seq, id FROM memories WHERE kind='episodic' "
                       "AND scope IN (?, ?)", (scope, GLOBAL)):
        seq.setdefault(short(r[0]), {})[str(r[1])] = r[2]
    return {"scope": scope, "scopes": scopes, "wake": wake, "seq": seq, "me": ME,
            "budget": WAKE_EPISODIC, "db": db_path()}


def store_key(c):
    """Cheap change key for caches; PRAGMA data_version is per connection."""
    return tuple(c.execute("SELECT (SELECT COUNT(*) FROM memories), (SELECT MAX(ts) FROM memories), "
                           "(SELECT COUNT(*) FROM touches), (SELECT COUNT(*) FROM summaries)").fetchone())


def serve_spine(c):
    """Every memory as one compact row, id order: the header strip and the
    client-side matrix and day strip are all drawn from this."""
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    return [[r["id"], r["kind"], r["scope"], r["ts"], r["id"] in dead, bool(r["entities"].strip())]
            for r in c.execute("SELECT id, kind, scope, ts, entities FROM memories ORDER BY id")]


OVERVIEW_CACHE = {}


def serve_overview(c, lock):
    """What the store holds and what needs a hand. Runs the real wake once per
    scope for the cost bars, so it is cached on the store key."""
    key = store_key(c)
    if OVERVIEW_CACHE.get("key") == key:
        return OVERVIEW_CACHE["data"]
    scopes = [r[0] for r in c.execute("SELECT DISTINCT scope FROM memories ORDER BY scope='global' DESC, scope")]
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    rows = c.execute("SELECT * FROM memories ORDER BY id").fetchall()
    live_rows = [r for r in rows if r["id"] not in dead]

    groups = {}
    for r in live_rows:
        groups.setdefault(norm(r["text"]), []).append(r)
    dups = [[m["id"] for m in g] for g in groups.values() if len({m["scope"] for m in g}) > 1]

    # Each scope judged as its own wake would see it: pending() sizes the
    # budget from the current project, so set that project per scope.
    due, wake_cost = {}, {}
    for sc in scopes:
        with lock:
            old = os.environ.get("SEGMEM_PROJECT")
            os.environ["SEGMEM_PROJECT"] = sc
            try:
                out = capture(cmd_wake, [])
                T = stream_len(c, "episodic", sc)
                if T:
                    due[sc] = {"T": T, "budget": budget_for(sc),
                               "pending": len(pending(c, "episodic", sc, T))}
            finally:
                if old is None:
                    os.environ.pop("SEGMEM_PROJECT", None)
                else:
                    os.environ["SEGMEM_PROJECT"] = old
        wake_cost[sc] = {"tokens": -(-len(out.encode()) // 4), "lines": out.count("\n") + 1}

    hot, pressed = [], []
    for row, p, n, since, reviewed, kept in note_pressure(c, scopes):
        if p < PROC_STALE_MIN or kept:
            continue
        (hot if reviewed else pressed).append(
            {"id": row["id"], "scope": row["scope"], "text": row["text"], "pressure": p, "since": since[:10]})
    dossiers = [{"entity": e, "pressure": p, "since": since[:10]}
                for e, p, n, since in dossier_pressure(c) if p >= STALE_MIN]

    overrides = 0
    for kind in ("identity", "procedural"):
        kr = [r for r in live_rows if r["kind"] == kind]
        glob = [r for r in kr if r["scope"] == GLOBAL]
        for pr in (r for r in kr if r["scope"] != GLOBAL):
            overrides += sum(1 for g in glob if entity_set(pr) & entity_set(g))

    data = {"total": len(rows), "live": len(live_rows), "superseded": len(dead),
            "summaries": c.execute("SELECT COUNT(*) FROM summaries").fetchone()[0],
            "scopes": scopes, "tags": len(known_tags(c)),
            "untagged": [r["id"] for r in live_rows if not r["entities"].strip()],
            "duplicates": dups, "due": due, "wake": wake_cost,
            "hot": hot, "pressed": pressed, "dossiers": dossiers, "overrides": overrides,
            "thresholds": {"procedural": PROC_STALE_MIN, "people": STALE_MIN}}
    OVERVIEW_CACHE.update(key=key, data=data)
    return data


def serve_hook(c, prompt, scope):
    """The prompt hook, run in-process and without its touch(): the same
    identifiers() and the same query, so the block is what the agent would
    receive, and trying phrasings presses on nothing."""
    tags = known_tags(c)
    ids = identifiers(prompt, tags)
    caps = re.findall(r"\b[A-Z][a-zA-Z0-9]{2,}\b", prompt)
    rules = {"code": [t for tok in re.findall(r"`([^`]+)`", prompt) for t in tok.split()],
             "issue": re.findall(r"#\d+", prompt),
             "path": re.findall(r"[A-Za-z][\w./-]*[_/.-][\w./-]*", prompt),
             "tag": [w for w in caps if w.lower() in tags]}
    kept = {i.lower() for i in ids}
    dropped, seen = [], set()
    for words in rules.values():
        for w in words:
            k = w.strip("`.,;:()[]{}'\"").lower()
            if k in seen or k in kept:
                continue
            seen.add(k)
            dropped.append({"word": w, "why": "too short" if len(k) <= 2 else
                            "stop word" if k in STOP else "dropped"})
    for w in dict.fromkeys(caps):
        if w.lower() not in tags and w.lower() not in kept:
            lw = w.lower()
            near = next((t for t in sorted(tags) if t.startswith(lw + "-") or t.endswith("-" + lw)
                         or (len(lw) > 3 and lw in t)), None)
            dropped.append({"word": w, "why": "capitalized but not a tag: prose",
                            "near": tags[near] if near else None})
    rows, orows, q = [], [], None
    if ids:
        q = " OR ".join('"%s"' % i.replace('"', '""') for i in ids)
        try:
            rows = c.execute(
                "SELECT m.* FROM memories_fts f JOIN memories m ON m.id=f.rowid "
                "WHERE memories_fts MATCH ? AND m.scope IN (?,?) AND %s "
                "ORDER BY rank LIMIT ?" % LIVE, (q, GLOBAL, scope, HOOK_MAX)).fetchall()
        except sqlite3.OperationalError:
            rows = []
        oc = org_connect()
        orows = org_search(oc, q, HOOK_MAX - len(rows)) if oc and len(rows) < HOOK_MAX else []
    out = []
    if rows or orows:
        out.append("<segmem-recall>")
        for r in rows:
            out.append("#%d %s %s %s: %s" % (r["id"], r["ts"][:10], r["kind"], short(r["scope"]), r["text"]))
        for r in orows:
            out.append(org_line(r, path=False))
        out.append("</segmem-recall>")
    return {"identifiers": ids, "rules": rules, "dropped": dropped, "fts": q,
            "output": "\n".join(out), "scope": scope, "hits": len(rows) + len(orows), "max": HOOK_MAX}


def pending_at(c, scope, T, budget):
    """pending() with an explicit budget instead of the cwd's. Same walk."""
    need = []

    def walk(lo, hi):
        if hi - lo == 1 or summary(c, "episodic", scope, lo, hi) is not None:
            return
        mid = (lo + hi) // 2
        walk(lo, mid)
        walk(mid, hi)
        need.append((lo, hi))

    for lo, hi in cover(T, budget):
        walk(lo, hi)
    return sorted(set(need), key=lambda b: (b[1] - b[0], b[0]))


def serve_tree(c, scope, budget, T):
    real_T = stream_len(c, "episodic", scope)
    T = max(T or real_T, real_T)
    budget = max(1, budget or WAKE_EPISODIC)
    sums = {(lo, hi): text for lo, hi, text in c.execute(
        "SELECT lo, hi, text FROM summaries WHERE kind='episodic' AND scope=?", (scope,))}
    leaves = [dict(r) for r in c.execute(
        "SELECT id, seq, ts, entities, text FROM memories WHERE kind='episodic' AND scope=? ORDER BY seq",
        (scope,))]
    cov = [{"lo": lo, "hi": hi, "summary": sums.get((lo, hi)),
            "span": span(c, scope, lo, min(hi, real_T)) if lo < real_T else ""}
           for lo, hi in cover(T, budget)]
    return {"scope": scope, "T": T, "real_T": real_T, "budget": budget, "cover": cov,
            "pending": pending_at(c, scope, T, budget), "leaves": leaves,
            "summaries": [{"lo": k[0], "hi": k[1], "text": v} for k, v in sorted(sums.items())]}


def near_tags(tags):
    """Tag pairs that probably mean one thing: close spelling (difflib >= 0.8,
    the cutoff note's own hint uses) or one tag being a hyphen-delimited part
    of another (`atlas` in `system-atlas`), which difflib misses."""
    import difflib
    keys = sorted(tags)
    pairs, seen = [], set()

    def add(a, b, why):
        key = tuple(sorted((a, b)))
        if key not in seen:
            seen.add(key)
            pairs.append({"a": tags[key[0]], "b": tags[key[1]], "why": why,
                          "ratio": round(difflib.SequenceMatcher(None, *key).ratio(), 2)})

    for k in keys:
        for n in difflib.get_close_matches(k, [x for x in keys if x != k], n=3, cutoff=0.8):
            add(k, n, "similar spelling")
        for part in set(re.split(r"[-_./]", k)) - {k}:
            if part in tags:
                add(k, part, "%s is part of %s" % (part, k))
    return pairs


def serve_entities(c):
    rows = [r for r in c.execute("SELECT * FROM memories WHERE %s ORDER BY id" % LIVE)]
    people = {e for r in rows if r["kind"] == "people" for e in entity_set(r)}
    tags = known_tags(c)
    per, co = {}, {}
    for r in rows:
        es = sorted(entity_set(r))
        for e in es:
            d = per.setdefault(e, {"n": 0, "kinds": {}, "scopes": {}, "ids": []})
            d["n"] += 1
            d["kinds"][r["kind"]] = d["kinds"].get(r["kind"], 0) + 1
            d["scopes"][short(r["scope"])] = d["scopes"].get(short(r["scope"]), 0) + 1
            d["ids"].append(r["id"])
        for i in range(len(es)):
            for k in range(i + 1, len(es)):
                co[(es[i], es[k])] = co.get((es[i], es[k]), 0) + 1
    nodes = [dict(id=k, label=tags.get(k, k), person=k in people, **v)
             for k, v in sorted(per.items(), key=lambda kv: -kv[1]["n"])]
    edges = [{"a": a, "b": b, "n": n} for (a, b), n in sorted(co.items(), key=lambda kv: -kv[1])]
    orphans = [t for t in tags.values() if re.fullmatch(r"[A-Z][a-z]+", t) and t.lower() not in people]
    return {"nodes": nodes, "edges": edges, "near": near_tags(tags), "orphans": orphans,
            "untagged": sum(1 for r in rows if not r["entities"].strip()), "live": len(rows)}


def word_diff(a, b):
    """Word-level diff as [op, text] segments: '=' kept, '-' removed, '+' added."""
    import difflib
    wa, wb = a.split(), b.split()
    out = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, wa, wb).get_opcodes():
        if tag == "equal":
            out.append(["=", " ".join(wa[i1:i2])])
        else:
            if i2 > i1:
                out.append(["-", " ".join(wa[i1:i2])])
            if j2 > j1:
                out.append(["+", " ".join(wb[j1:j2])])
    return out


def serve_chains(c):
    rows = {r["id"]: dict(r) for r in c.execute("SELECT * FROM memories ORDER BY id")}
    nxt = {r["supersedes"]: r["id"] for r in rows.values() if r["supersedes"]}
    out = []
    for h in [i for i, r in rows.items() if r["supersedes"] is None and i in nxt]:
        chain, i = [], h
        while i is not None:
            chain.append(rows[i])
            i = nxt.get(i)
        for k in range(1, len(chain)):
            d = word_diff(chain[k - 1]["text"], chain[k]["text"])
            chain[k]["diff"] = d
            chain[k]["added"] = sum(len(t.split()) for op, t in d if op == "+")
            chain[k]["removed"] = sum(len(t.split()) for op, t in d if op == "-")
        out.append({"head": h, "kind": rows[h]["kind"], "scope": rows[h]["scope"],
                    "entities": sorted({e for m in chain for e in entity_set(m)}),
                    "versions": chain})
    out.sort(key=lambda ch: (-len(ch["versions"]), -ch["versions"][-1]["id"]))
    return {"chains": out}


def cmd_serve(c, args):
    import json, threading, time, webbrowser
    from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
    from urllib.parse import urlparse, parse_qs
    opts, pos = flags(args)
    port = int(opts.get("port", SERVE_PORT))
    c.close()
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path == "/":
                return self.reply(200, SERVE_PAGE, "text/html")
            if u.path == "/api/events":
                return self.events()
            if not u.path.startswith("/api/"):
                return self.reply(404, "not found", "text/plain")
            db = connect()
            try:
                name = u.path[5:]
                if name == "state":
                    data = serve_state(db, q.get("scope"), lock)
                elif name == "fact":
                    data = serve_fact(db, int(q.get("id", 0)))
                elif name == "search":
                    f = {k: q[k] for k in ("kind", "scope", "entity", "since", "dead") if k in q}
                    data = serve_search(db, q.get("q", ""), f)
                elif name == "feed":
                    data = serve_feed(db)
                elif name == "spine":
                    data = serve_spine(db)
                elif name == "overview":
                    data = serve_overview(db, lock)
                elif name == "hook":
                    data = serve_hook(db, q.get("prompt", ""), q.get("scope") or project())
                elif name == "tree":
                    data = serve_tree(db, q.get("scope") or project(),
                                      int(q.get("budget") or 0), int(q.get("T") or 0))
                elif name == "entities":
                    data = serve_entities(db)
                elif name == "chains":
                    data = serve_chains(db)
                else:
                    data = None
            finally:
                db.close()
            if data is None:
                return self.reply(404, '{"error": "not found"}')
            self.reply(200, json.dumps(data))

        def events(self):
            """Server-sent events: one line per commit by any other
            connection, detected through PRAGMA data_version."""
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            db = connect()
            v = db.execute("PRAGMA data_version").fetchone()[0]
            beat = 0
            try:
                self.wfile.write(b": open\n\n")
                self.wfile.flush()
                while True:
                    time.sleep(0.5)
                    v2 = db.execute("PRAGMA data_version").fetchone()[0]
                    if v2 != v:
                        v = v2
                        self.wfile.write(b'data: {"v": %d}\n\n' % v)
                    else:
                        beat += 1
                        if beat % 30:
                            continue
                        self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            finally:
                db.close()

    ThreadingHTTPServer.daemon_threads = True
    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = "http://127.0.0.1:%d/" % port
    print("segmem serve: %s (Ctrl-C to stop)" % url, flush=True)
    if "no-open" not in opts:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


