def identifiers(text, tags=()):
    """Words in a prompt worth looking up: code spans, #123, paths and
    snake/kebab names, and capitalised words that are known tags. A proper
    noun that nobody tagged is prose, not an identifier: "Claude" would
    otherwise match every memory."""
    found = []
    for tok in re.findall(r"`([^`]+)`", text):
        found += tok.split()
    found += re.findall(r"#\d+", text)
    found += re.findall(r"[A-Za-z][\w./-]*[_/.-][\w./-]*", text)
    found += [w for w in re.findall(r"\b[A-Z][a-zA-Z0-9]{2,}\b", text) if w.lower() in tags]
    out, seen = [], set()
    for f in found:
        k = f.strip("`.,;:()[]{}'\"").lower()
        if len(k) > 2 and k not in STOP and k not in seen:
            seen.add(k)
            out.append(f.strip("`.,;:()[]{}'\""))
    return out


def cmd_hook(c, args):
    """Claude Code UserPromptSubmit hook: reads the prompt as JSON on stdin,
    prints matching memories as extra context. Never fails the prompt.

    `--once` claims the session for one path: the claim is keyed on the
    session alone (source `session`), so the first prompt decides who serves
    recall for every prompt after it. There is no id both paths see per
    prompt, so per-prompt arbitration is not available."""
    opts, _ = flags(args)
    data = hook_input()
    text = data.get("prompt", "")
    sid = opts.get("session") or data.get("session_id", "")
    if "once" in opts:
        served = opts.get("served", "command")
        if sid and claim(c, sid, "hook", "session", served) != served:
            return          # the other hook path owns this session's recall
    tags = known_tags(c)
    ids = identifiers(text, tags)
    if not ids:
        return
    try:
        touch(c, [i for i in ids if i.lower() in tags], "prompt", sid)
    except sqlite3.OperationalError:
        pass
    q = " OR ".join('"%s"' % i.replace('"', '""') for i in ids)
    p = project()
    try:
        rows = c.execute(
            "SELECT m.* FROM memories_fts f JOIN memories m ON m.id=f.rowid "
            "WHERE memories_fts MATCH ? AND m.scope IN (?,?) AND %s "
            "ORDER BY rank LIMIT ?" % LIVE, (q, GLOBAL, p, HOOK_MAX)).fetchall()
    except sqlite3.OperationalError:
        return
    oc = org_connect()
    orows = org_search(oc, q, HOOK_MAX - len(rows)) if oc and len(rows) < HOOK_MAX else []
    if not rows and not orows:
        return
    print("<segmem-recall>")
    for r in rows:
        print("#%d %s %s %s: %s" % (r["id"], r["ts"][:10], r["kind"], short(r["scope"]), r["text"]))
    for r in orows:
        print(org_line(r, path=False))
    print("</segmem-recall>")


