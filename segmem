// ---- spine: every memory as one tick, id order, kind hue, superseded hollow
async function loadSpine() {
  const sp = await j('/api/spine'); S.spine = sp;
  const n = sp.length || 1, W = 1000, H = 14, w = Math.max(W / n - 0.5, 0.75);
  $('#spine').innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="${n} memories">` + sp.map(([id, kind, scope, ts, dead], i) => {
    const h = kind === 'episodic' ? H : kind === 'people' ? H * 0.55 : H * 0.8;
    const dim = S.sel && S.sel !== id ? ' opacity=".35"' : '';
    return `<rect x="${(i / n * W).toFixed(2)}" y="${H - h}" width="${w.toFixed(2)}" height="${h}" rx=".5" fill="${dead ? 'none' : `var(--k-${kind})`}" stroke="${dead ? `var(--k-${kind})` : 'none'}" stroke-width="${dead ? .6 : 0}"${dim} data-id="${id}"><title>#${id} ${kind} · ${short(scope)}${dead ? ' · superseded' : ''}</title></rect>`;
  }).join('') + '</svg>';
  const last = sp[sp.length - 1];
  const scopes = new Set(sp.map(r => r[2]));
  $('#hmeta').textContent = `${fmt(n)} memories · ${scopes.size} scopes${last ? ' · last ' + rel(last[3]) : ''}`;
}

