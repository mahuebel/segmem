#!/usr/bin/env python3
"""segmem: segmented, scoped memory for agents. One file, SQLite, no daemon.

Layers, lakehouse style:
  bronze  memories   append-only facts; never edited, only superseded
  silver  kind/scope/entities columns, filled at write time; FTS5 over text
  gold    summaries  the episodic merge tree, per scope; rebuildable from bronze

Kinds, and what wake does with each:
  identity    who the user is, how they like to work   loaded whole   supersedes
  procedural  how things work here                     loaded whole   supersedes
  episodic    what happened                            decaying cover  history
  people      who someone is                           names only; recall by name

Touches are telemetry, not memory: who got mentioned, recalled, or tagged,
pressing on the people dossiers and procedural facts. Wake never prints
them as facts.
"""
import os
import re
import sqlite3
import subprocess
import sys

KINDS = ("identity", "procedural", "episodic", "people")
GLOBAL = "global"
MAX_BYTES = 280
WAKE_EPISODIC = 64      # lines of project episodic cover
WAKE_EPISODIC_GLOBAL = 16
PROMOTE_MIN = 3         # see should_promote()
STALE_MIN = 6           # weighted touches before a dossier is under pressure
PROC_STALE_MIN = 12     # same, per procedural note; hub entities accrue fast
TOUCH_WEIGHT = {"note": 3, "recall": 2, "prompt": 1}

ME = os.path.abspath(sys.argv[0])


# ---------------------------------------------------------------- store

def db_path():
    d = os.environ.get("SEGMEM_DIR") or os.path.expanduser("~/.segmem")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "segmem.db")


SCHEMA = """
CREATE TABLE IF NOT EXISTS memories (
  id         INTEGER PRIMARY KEY,
  ts         TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  kind       TEXT NOT NULL CHECK (kind IN ('identity','procedural','episodic','people')),
  scope      TEXT NOT NULL,
  seq        INTEGER NOT NULL,           -- position within (kind, scope) stream
  entities   TEXT NOT NULL DEFAULT '',   -- comma-separated subjects: people, components
  supersedes INTEGER REFERENCES memories(id),
  text       TEXT NOT NULL,
  UNIQUE (kind, scope, seq)
);
CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
  text, entities, content='memories', content_rowid='id'
);
CREATE TRIGGER IF NOT EXISTS memories_ai AFTER INSERT ON memories BEGIN
  INSERT INTO memories_fts(rowid, text, entities) VALUES (new.id, new.text, new.entities);
END;
CREATE TABLE IF NOT EXISTS summaries (
  kind  TEXT NOT NULL, scope TEXT NOT NULL,
  lo    INTEGER NOT NULL, hi INTEGER NOT NULL,
  text  TEXT NOT NULL,
  PRIMARY KEY (kind, scope, lo, hi)
);
CREATE TABLE IF NOT EXISTS touches (
  ts      TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  entity  TEXT NOT NULL,
  kind    TEXT NOT NULL CHECK (kind IN ('note','recall','prompt','review','nag')),
  session TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS touches_by_entity ON touches(entity, ts);
"""


def connect():
    c = sqlite3.connect(db_path(), timeout=10)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA foreign_keys=ON")
    c.executescript(SCHEMA)
    return c


def project():
    """Scope key for the cwd: the main repo path, shared across worktrees."""
    if os.environ.get("SEGMEM_PROJECT"):
        return os.environ["SEGMEM_PROJECT"]
    try:
        common = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return GLOBAL
    return os.path.dirname(os.path.abspath(common))


LIVE = "id NOT IN (SELECT supersedes FROM memories WHERE supersedes IS NOT NULL)"


def live(c, kind, scopes):
    q = ("SELECT * FROM memories WHERE kind=? AND scope IN (%s) AND %s ORDER BY id"
         % (",".join("?" * len(scopes)), LIVE))
    return c.execute(q, (kind, *scopes)).fetchall()


def stream_len(c, kind, scope):
    # MAX+1, not COUNT: forget can leave a hole in a non-episodic stream, and
    # a reused seq would collide with the rows past it.
    r = c.execute("SELECT COALESCE(MAX(seq)+1, 0) FROM memories WHERE kind=? AND scope=?",
                  (kind, scope)).fetchone()
    return r[0]


def entity_set(row):
    return {e.strip().lower() for e in row["entities"].split(",") if e.strip()}


# ---------------------------------------------------------------- tree
# An aligned power-of-two block [lo,hi) of one (kind, scope) stream is
# summarised into one line. Blocks form a binary merge tree; wake prints a
# budget-bounded cover of it, finest near the present. The shape is an
# exponential histogram (Datar, Gionis, Indyk, Motwani, 2002): a block may
# be as wide as it is old, so each doubling of age gets about the same
# number of lines.

def cover(T, budget):
    """At most `budget` aligned blocks tiling [0,T), newest finest.

    Greedy: keep a heap of blocks keyed by age/size, where age is the
    distance from the block's start to the present. Split the block with the
    smallest ratio (the widest for its age) until the budget is spent. A
    block that overhangs the end of the stream must split first; a single
    memory is final. One pass, O(budget log budget)."""
    if T <= 0:
        return []
    if T <= budget:
        return [(i, i + 1) for i in range(T)]
    import heapq
    root = 1 << (T - 1).bit_length()

    def key(lo, hi):
        if hi > T:
            return (-1.0, -lo)               # overhang: must split
        return ((T - lo) / (hi - lo), -lo)   # widest for its age, newest first

    heap, done = [(key(0, root), 0, root)], []
    while heap and len(heap) + len(done) < budget:
        _, lo, hi = heapq.heappop(heap)
        mid = (lo + hi) // 2
        for a, b in ((lo, mid), (mid, hi)):
            if a >= T:
                continue
            if b - a == 1:
                done.append((a, b))
            else:
                heapq.heappush(heap, (key(a, b), a, b))
    out = done + [(lo, hi) for _, lo, hi in heap]
    if any(hi > T for _, hi in out):
        # the budget ran out before every overhang split: split those
        # regardless, since a block past the end cannot be summarised
        fixed = []
        for lo, hi in out:
            while hi > T:
                mid = (lo + hi) // 2
                if mid >= T:
                    hi = mid
                else:
                    fixed.append((lo, mid))
                    lo = mid
            fixed.append((lo, hi))
        out = fixed
    return sorted(out)


def summary(c, kind, scope, lo, hi):
    r = c.execute("SELECT text FROM summaries WHERE kind=? AND scope=? AND lo=? AND hi=?",
                  (kind, scope, lo, hi)).fetchone()
    return r[0] if r else None


def budget_for(scope):
    """Lines of episodic cover wake prints for a scope, from the cwd's view."""
    p = project()
    return WAKE_EPISODIC if scope == p or p == GLOBAL else WAKE_EPISODIC_GLOBAL


def pending(c, kind, scope, T):
    """Blocks wake needs and does not have, smallest first. A block is needed
    when the cover prints it, or when a needed block's summary is built from
    it. Blocks the cover does not print are never requested: no premature
    compression."""
    need = []

    def walk(lo, hi):
        if hi - lo == 1 or summary(c, kind, scope, lo, hi) is not None:
            return
        mid = (lo + hi) // 2
        walk(lo, mid)
        walk(mid, hi)
        need.append((lo, hi))

    for lo, hi in cover(T, budget_for(scope)):
        walk(lo, hi)
    return sorted(set(need), key=lambda b: (b[1] - b[0], b[0]))


def span(c, scope, lo, hi):
    """The dates a block of episodic memories covers: one date, or first..last."""
    r = c.execute("SELECT MIN(ts), MAX(ts) FROM memories WHERE kind='episodic' AND scope=? "
                  "AND seq>=? AND seq<?", (scope, lo, hi)).fetchone()
    a, b = (r[0] or "")[:10], (r[1] or "")[:10]
    return a if a == b else "%s..%s" % (a, b[5:])


def nap_prompt(c, kind, scope, lo, hi, left):
    if hi - lo == 2:
        rows = c.execute("SELECT seq, ts, text FROM memories WHERE kind=? AND scope=? "
                         "AND seq>=? AND seq<? ORDER BY seq", (kind, scope, lo, hi))
        body = "\n".join("  #%d %s %s" % (r["seq"], r["ts"][:10], r["text"]) for r in rows)
    else:
        mid, halves = (lo + hi) // 2, []
        for a, b in ((lo, mid), (mid, hi)):
            s = summary(c, kind, scope, a, b)
            if s is None:
                die("Summary #%d-%d is missing; the tree will rebuild it on the next nap."
                    % (a, b - 1))
            halves.append("  #%d-%d %s %s" % (a, b - 1, span(c, scope, a, b), s))
        body = "\n".join(halves)
    tail = "" if not left else "\n%d compression%s remain after this one." % (
        left, "" if left == 1 else "s")
    return ("Compress episodic memories #%d-%d (%s) into one line of at most %d "
            "bytes.\nKeep what has lasting effect, drop what does not. Invent "
            "nothing.\nKeep doubts as doubts: an unknown cause must not become "
            "a cause.\n\n%s\n%s\nRun: %s nap %d-%d \"<your line>\""
            % (lo, hi - 1, short(scope), MAX_BYTES, body, tail, ME, lo, hi - 1))


def next_nap(c, scope):
    for sc in (scope, GLOBAL) if scope != GLOBAL else (GLOBAL,):
        T = stream_len(c, "episodic", sc)
        todo = pending(c, "episodic", sc, T)
        if todo:
            lo, hi = todo[0]
            return sc, nap_prompt(c, "episodic", sc, lo, hi, len(todo) - 1)
    return None


# ---------------------------------------------------------------- promotion

def norm(text):
    return " ".join(re.sub(r"[^\w\s]", " ", text.lower()).split())


def should_promote(row, siblings):
    """A project fact earns global scope when the same statement (ignoring
    case and punctuation) is live in at least PROMOTE_MIN distinct projects,
    the candidate's own project included. Siblings that merely share a
    subject but say something else are not evidence."""
    agree = {s["scope"] for s in siblings if norm(s["text"]) == norm(row["text"])}
    agree.add(row["scope"])
    return len(agree) >= PROMOTE_MIN


# ---------------------------------------------------------------- pressure
# A dossier is a claim under test; touches are the evidence arriving since it
# was last written or reviewed. Only a people note or an explicit review
# resets the clock: an episodic note about a person raises pressure on the
# dossier, it never relieves it.

def touch(c, entities, kind, session=""):
    rows = [(e.strip().lower(), kind, session) for e in entities if e.strip()]
    if rows:
        with c:
            c.executemany("INSERT INTO touches(entity,kind,session) VALUES (?,?,?)", rows)


def dossier_clock(c):
    """Entity -> when its dossier last met the evidence: the newest people
    note that tags it, or a later explicit review."""
    clock = {}
    for ts, ents in c.execute("SELECT ts, entities FROM memories WHERE kind='people'"):
        for e in ents.lower().split(","):
            if e.strip():
                clock[e.strip()] = max(clock.get(e.strip(), ""), ts)
    for e, ts in c.execute(
            "SELECT entity, MAX(ts) FROM touches WHERE kind='review' GROUP BY entity"):
        if e in clock:
            clock[e] = max(clock[e], ts)
    return clock


def dossier_pressure(c):
    """Weighted touches per entity since its clock, heaviest first."""
    out = []
    for e, since in dossier_clock(c).items():
        n = dict(c.execute("SELECT kind, COUNT(*) FROM touches WHERE entity=? AND ts>? "
                           "AND kind IN ('note','recall','prompt') GROUP BY kind", (e, since)))
        p = sum(TOUCH_WEIGHT[k] * v for k, v in n.items())
        if p:
            out.append((e, p, n, since))
    return sorted(out, key=lambda r: (-r[1], r[0]))


def note_clock(c, row):
    """When procedural note #id last met the evidence: its own write, or a
    later explicit review (touch by id)."""
    r = c.execute("SELECT MAX(ts) FROM touches WHERE kind='review' AND entity=?",
                  ("#%d" % row["id"],)).fetchone()
    return max(row["ts"], r[0] or "")


def note_pressure(c, scopes):
    """Weighted touches per live procedural note since its clock, heaviest
    first. Yields (row, pressure, counts, since, reviewed, kept): reviewed
    means it survived an earlier cycle; kept means the agent chose memory
    over the repo, so export is not suggested again."""
    out = []
    for row in live(c, "procedural", scopes):
        ents = sorted(entity_set(row))
        if not ents:
            continue
        since = note_clock(c, row)
        n = dict(c.execute(
            "SELECT kind, COUNT(*) FROM touches WHERE entity IN (%s) AND ts>=? "
            "AND kind IN ('note','recall','prompt') GROUP BY kind"
            % ",".join("?" * len(ents)), (*ents, since)))
        p = sum(TOUCH_WEIGHT[k] * v for k, v in n.items())
        if not p:
            continue
        r = c.execute("SELECT COUNT(*), COALESCE(SUM(session='keep'), 0) FROM touches "
                      "WHERE kind='review' AND entity=?", ("#%d" % row["id"],)).fetchone()
        out.append((row, p, n, since, r[0] > 0, r[1] > 0))
    return sorted(out, key=lambda t: (-t[1], t[0]["id"]))


def repo_home(row):
    return ("~/.claude/CLAUDE.md" if row["scope"] == GLOBAL
            else "README, CLAUDE.md, or the file it governs")


def fmt_counts(n):
    return ", ".join("%d %s%s" % (n[k], k, "" if n[k] == 1 else "s")
                     for k in ("note", "recall", "prompt") if n.get(k))


# ---------------------------------------------------------------- commands

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def check_len(text):
    n = len(text.encode())
    if n <= MAX_BYTES:
        return
    keep = text.encode()[:MAX_BYTES].decode("utf-8", "ignore")
    die("Too long: %d bytes, max %d. The mark is where the limit falls; "
        "trim the tail, don't rewrite:\n%s▮%s" % (n, MAX_BYTES, keep, text[len(keep):]))


def flags(args):
    """Split `--k=v` flags from positionals."""
    opts, pos = {}, []
    for a in args:
        if a.startswith("--") and "=" in a:
            k, v = a[2:].split("=", 1)
            opts[k] = v
        elif a.startswith("--"):
            opts[a[2:]] = "1"
        else:
            pos.append(a)
    return opts, pos


def known_tags(c):
    """Every tag ever written, keyed by lowercase, valued by stored spelling.
    One vocabulary across scopes: promotion matches siblings by tag."""
    tags = {}
    for (ents,) in c.execute("SELECT entities FROM memories WHERE entities != ''"):
        for e in ents.split(","):
            e = e.strip()
            if e:
                tags.setdefault(e.lower(), e)
    return tags


def canon(c, raw, kind):
    """Trim and dedupe tags; a tag that matches a known one ignoring case
    takes the stored spelling. Returns (entities, hints): hints name a new
    tag's near matches, and a name-like tag with no people record."""
    tags, out, seen, hints = known_tags(c), [], set(), []
    people = {e for (ents,) in c.execute("SELECT entities FROM memories WHERE kind='people'")
              for e in ents.lower().split(",") if e.strip()}
    import difflib
    for e in raw.split(","):
        e = e.strip()
        k = e.lower()
        if not e or k in seen:
            continue
        seen.add(k)
        if k in tags:
            out.append(tags[k])
            continue
        out.append(e)
        near = difflib.get_close_matches(k, list(tags), n=3, cutoff=0.8)
        if near:
            hints.append("new tag: %s (similar: %s)" % (e, ", ".join(tags[n] for n in near)))
    if kind != "people":
        for e in out:
            if re.fullmatch(r"[A-Z][a-z]+", e) and e.lower() not in people:
                hints.append("no people record for %s; if a person: %s note people "
                             "\"<who they are>\" --entities=%s" % (e, ME, e))
    return ",".join(out), hints


def cmd_note(c, args):
    opts, pos = flags(args)
    if len(pos) != 2 or pos[0] not in KINDS:
        die("usage: %s note <%s> \"<text>\" [--scope=global|project] "
            "[--entities=a,b] [--supersedes=id]" % (ME, "|".join(KINDS)))
    kind, text = pos
    text = " ".join(text.split())
    check_len(text)
    default_scope = GLOBAL if kind in ("identity", "people") else project()
    scope = {"global": GLOBAL, "project": project()}.get(opts.get("scope"), None) \
        or opts.get("scope") or default_scope
    sup = int(opts["supersedes"]) if "supersedes" in opts else None
    if sup is not None and not c.execute("SELECT 1 FROM memories WHERE id=?", (sup,)).fetchone():
        die("No memory #%d to supersede." % sup)
    entities, hints = canon(c, opts.get("entities", ""), kind)
    with c:
        seq = stream_len(c, kind, scope)
        c.execute("INSERT INTO memories(kind,scope,seq,entities,supersedes,text) "
                  "VALUES (?,?,?,?,?,?)",
                  (kind, scope, seq, entities, sup, text))
        rid = c.execute("SELECT last_insert_rowid()").fetchone()[0]
    print("#%d %s %s" % (rid, kind, "(%s)" % short(scope)))
    for h in hints + scope_hints(c, entities, scope, rid):
        print(h)
    if kind != "people":
        # a people note is the dossier revision itself, not evidence against it
        touch(c, entities.split(","), "note")
    nap = next_nap(c, project())
    if nap:
        print("\n" + nap[1])


def scope_hints(c, entities, scope, rid):
    """A tag whose whole history lives in another project marks a likely
    misfile: recall searches only cwd's project plus global, so a wrong-scoped
    note is invisible to exactly the sessions that need it."""
    if scope == GLOBAL or not entities:
        return []
    lived = {}
    for r in c.execute("SELECT scope, entities FROM memories WHERE entities!='' AND id!=?",
                       (rid,)):
        for e in entity_set(r):
            lived.setdefault(e, set()).add(r["scope"])
    hints = []
    for e in entities.lower().split(","):
        others = lived.get(e.strip(), set()) - {GLOBAL}
        if others and scope not in others:
            hints.append("prior notes about %s live in %s, not %s; misfiled? %s forget %d, "
                         "then re-note from the right repo or with --scope=<path>"
                         % (e.strip(), ", ".join(sorted(short(s) for s in others)),
                            short(scope), ME, rid))
    return hints


def short(scope):
    return scope if scope == GLOBAL else os.path.basename(scope)


def cmd_nap(c, args):
    if len(args) != 2 or not re.fullmatch(r"\d+-\d+", args[0]):
        die("usage: %s nap <lo>-<hi> \"<line>\"" % ME)
    lo, hi = (int(x) for x in args[0].split("-"))
    hi += 1
    text = " ".join(args[1].split())
    check_len(text)
    nap = next_nap(c, project())
    if not nap:
        die("Nothing to compress.")
    scope = nap[0]
    with c:
        c.execute("INSERT OR REPLACE INTO summaries(kind,scope,lo,hi,text) VALUES (?,?,?,?,?)",
                  ("episodic", scope, lo, hi, text))
    nap = next_nap(c, project())
    print(nap[1] if nap else "All compressed.")


def cmd_forget(c, args):
    if len(args) != 1 or not re.fullmatch(r"\d+(-\d+)?", args[0]):
        die("usage: %s forget <id> | <lo>-<hi>   (a misfiled note by id, or a summary block)" % ME)
    if "-" in args[0]:
        lo, hi = (int(x) for x in args[0].split("-"))
        with c:
            n = c.execute("DELETE FROM summaries WHERE kind='episodic' AND scope=? AND lo=? AND hi=?",
                          (project(), lo, hi + 1)).rowcount
        print("Dropped %d summary." % n if n else "No such summary.")
        return
    rid = int(args[0])
    row = c.execute("SELECT * FROM memories WHERE id=?", (rid,)).fetchone()
    if not row:
        die("No memory #%d." % rid)
    # A hole mid-stream would break the episodic tree, whose blocks index by
    # seq; other kinds load whole and tolerate gaps.
    if row["kind"] == "episodic" and row["seq"] != stream_len(c, "episodic", row["scope"]) - 1:
        die("#%d is not the newest episodic note in %s; supersede it instead."
            % (rid, short(row["scope"])))
    ref = c.execute("SELECT id FROM memories WHERE supersedes=?", (rid,)).fetchone()
    if ref:
        die("#%d is superseded by #%d; forget that one first." % (rid, ref["id"]))
    with c:
        c.execute("INSERT INTO memories_fts(memories_fts, rowid, text, entities) "
                  "VALUES ('delete', ?, ?, ?)", (rid, row["text"], row["entities"]))
        c.execute("DELETE FROM memories WHERE id=?", (rid,))
        if row["kind"] == "episodic":
            # summaries that covered the deleted row describe rows that no
            # longer exist; drop them, the tree rebuilds on request
            c.execute("DELETE FROM summaries WHERE kind='episodic' AND scope=? AND hi>?",
                      (row["scope"], row["seq"]))
    print("Forgot #%d (%s, %s)." % (rid, row["kind"], short(row["scope"])))
    if row["supersedes"]:
        print("#%d is live again." % row["supersedes"])


def cmd_recall(c, args):
    if not args:
        die("usage: %s recall <query>   (FTS5 syntax; searches every scope and kind)" % ME)
    q = " ".join(args)
    sql = ("SELECT m.* FROM memories_fts f JOIN memories m ON m.id=f.rowid "
           "WHERE memories_fts MATCH ? ORDER BY rank LIMIT 50")
    try:
        rows = c.execute(sql, (q,)).fetchall()
    except sqlite3.OperationalError:
        # FTS5 reads a bare hyphen or colon as syntax ("no such column: op"
        # for mem-op). Retry with terms quoted, keeping the operators.
        q = " ".join(t if t in ("OR", "AND", "NOT") else '"%s"' % t.replace('"', '""')
                     for t in q.split())
        try:
            rows = c.execute(sql, (q,)).fetchall()
        except sqlite3.OperationalError as e:
            die("Bad query: %s" % e)
    if not rows:
        print("No match.")
        return
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    for r in rows:
        flag = " [superseded]" if r["id"] in dead else ""
        tags = " [%s]" % r["entities"] if r["entities"] else ""
        print("#%d %s %s %s%s%s: %s" % (r["id"], r["ts"][:10], r["kind"], short(r["scope"]),
                                        tags, flag, r["text"]))
    touch(c, {e for r in rows for e in entity_set(r)}, "recall")


def cmd_touch(c, args):
    opts, pos = flags(args)
    if len(pos) != 1:
        die("usage: %s touch <entity|id> [--keep]   (reviewed, unchanged; resets pressure)" % ME)
    if pos[0].isdigit():
        row = c.execute("SELECT * FROM memories WHERE id=? AND %s" % LIVE,
                        (int(pos[0]),)).fetchone()
        if not row or row["kind"] != "procedural":
            die("No live procedural note #%s." % pos[0])
        # 'keep' rides in the free-text session column: the touches CHECK
        # constraint predates it, and a table rebuild isn't worth one flag.
        touch(c, ["#%d" % row["id"]], "review", "keep" if "keep" in opts else "")
        print('Reviewed #%d unchanged: "%s"%s' % (
            row["id"], row["text"],
            "; kept in memory, export will not be suggested again." if "keep" in opts
            else ". The next real change still needs a supersede."))
        return
    if "keep" in opts:
        die("--keep applies to a procedural note id.")
    e = pos[0].strip().lower()
    if e not in dossier_clock(c):
        die("No people note tags %s." % pos[0])
    prow = None
    for r in c.execute("SELECT * FROM memories WHERE kind='people' AND %s ORDER BY id" % LIVE):
        if e in entity_set(r):
            prow = r
    touch(c, [e], "review")
    print('Reviewed %s unchanged: "%s". The next real change still needs a supersede.'
          % (e, prow["text"]))


def cmd_stale(c, args):
    opts, _ = flags(args)
    dmin = int(opts.get("min", STALE_MIN))
    pmin = int(opts.get("min", PROC_STALE_MIN))
    due = [r for r in dossier_pressure(c) if r[1] >= dmin]
    pdue = [r for r in note_pressure(c, [project(), GLOBAL]) if r[1] >= pmin]
    if "hook" in opts:
        return stale_hook(c, due, pdue)
    if not due and not pdue:
        print("No dossier under pressure (threshold %d)." % dmin)
        return
    for e, p, n, since in due:
        print("%s: pressure %d (%s) since %s. Supersede its people note or: %s touch %s"
