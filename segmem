  if (t.dataset.t) { setTab(t.dataset.t); return; }
  if (t.dataset.mx) { const [s, k] = t.dataset.mx.split('|'); S.f = {scope: s, kind: k}; S.q = ''; $('#q').value = ''; setTab('ledger'); return; }
  if (t.dataset.hs) { S.hookScope = t.dataset.hs; loadHook(); return; }
  if (t.dataset.ts) { S.treeScope = t.dataset.ts; S.treeT = 0; loadTree(); return; }
  if (t.dataset.tb) { S.treeBudget = +t.dataset.tb; loadTree(); return; }
  if (t.dataset.tt) { S.treeT = +t.dataset.tt; loadTree(); return; }
  if (t.dataset.es) { S.entSort = t.dataset.es; loadEntities(); return; }
  if (t.dataset.lk) { S.linKind = S.linKind === t.dataset.lk ? '' : t.dataset.lk; loadLineage(); return; }
  if (t.dataset.lc) { S.linSel = +t.dataset.lc; loadLineage(); return; }
  if (t.dataset.lm) { S.linMode = t.dataset.lm; loadLineage(); return; }
  if (t.dataset.s) { S.scope = t.dataset.s; S.sel = null; $('#insp').innerHTML = '<p class="mut">Select a line.</p>'; setTab('console'); return; }
  if (t.dataset.e !== undefined) { S.f = {entity: t.dataset.e}; S.q = ''; $('#q').value = ''; setTab('ledger'); return; }
  if (t.dataset.fk) { const k = t.dataset.fk, v = t.dataset.fv; if (S.f[k] === v) delete S.f[k]; else S.f[k] = v; loadLedger(); return; }
