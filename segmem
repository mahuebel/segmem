def capture(fn, args):
    """Run a command, return what it printed. Commands call sys.exit; here
    that is a result, not an exit."""
    import io
    out, err = io.StringIO(), io.StringIO()
    old = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = out, err
    try:
        fn(connect(), args)
    except SystemExit:
        pass
    finally:
        sys.stdout, sys.stderr = old
    return (out.getvalue() + err.getvalue()).strip()


def mcp_call(name, a):
    if name == "segmem_wake":
        return capture(cmd_wake, [])
    if name == "segmem_note":
        args = [a["kind"], a["text"]]
        for k in ("entities", "scope", "supersedes"):
            if a.get(k) not in (None, ""):
                args.append("--%s=%s" % (k, a[k]))
        return capture(cmd_note, args)
    if name == "segmem_recall":
        return capture(cmd_recall, [a["query"]])
    if name == "segmem_nap":
        return capture(cmd_nap, [a["range"], a["text"]])
    raise KeyError(name)


def cmd_mcp(c, args):
    import json
    c.close()

    def send(msg):
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except ValueError:
            continue
        rid, method, params = req.get("id"), req.get("method", ""), req.get("params") or {}
        if rid is None:
            continue  # a notification: nothing to answer
        try:
            if method == "initialize":
                result = {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                          "capabilities": {"tools": {}},
                          "serverInfo": {"name": "segmem", "version": "0.5.0"}}
            elif method == "ping":
                result = {}
            elif method == "tools/list":
                result = {"tools": MCP_TOOLS}
            elif method == "tools/call":
                text = mcp_call(params.get("name"), params.get("arguments") or {})
                result = {"content": [{"type": "text", "text": text or "(no output)"}]}
            else:
                send({"jsonrpc": "2.0", "id": rid,
                      "error": {"code": -32601, "message": "unknown method %s" % method}})
                continue
            send({"jsonrpc": "2.0", "id": rid, "result": result})
        except Exception as e:  # never let one bad call kill the server
            send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32000, "message": str(e)}})


