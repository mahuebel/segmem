def stale_hook(c, due, pdue):
    """Claude Code Stop hook: when a dossier or a procedural fact is under
    pressure, block the stop once per subject and session so a live agent
    reviews it. stop_hook_active means this stop is already the result of a
    block: let it through."""
    import json
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not isinstance(data, dict) or data.get("stop_hook_active"):
        return
    sid = data.get("session_id", "")
    nagged = {e for (e,) in c.execute(
        "SELECT DISTINCT entity FROM touches WHERE kind='nag' AND session=?", (sid,))}
    due = [r for r in due if r[0] not in nagged]
    pdue = [r for r in pdue if "#%d" % r[0]["id"] not in nagged]
    if not due and not pdue:
        return
    touch(c, [e for e, _, _, _ in due] + ["#%d" % r[0]["id"] for r in pdue], "nag", sid)
    parts = []
    if due:
        names = "; ".join("%s (%s since %s)" % (e, fmt_counts(n), since[:10])
                          for e, p, n, since in due)
        parts.append("Dossiers under pressure: %s. For each: supersede the people note "
                     "with what changed, or confirm it unchanged with `%s touch <entity>`."
                     % (names, ME))
    verify = [r for r in pdue if not (r[4] and not r[5])]
    export = [r for r in pdue if r[4] and not r[5]]
    if verify:
        parts.append("Procedural facts under pressure: %s. Verify each against the repo, "
                     "then supersede what changed or confirm with `%s touch <id>`."
                     % ("; ".join('#%d \"%s\"' % (r[0]["id"], r[0]["text"][:60])
                                  for r in verify), ME))
