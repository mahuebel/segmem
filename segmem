async function loadConsole() {
  const d = await j('/api/state' + (S.scope ? '?scope=' + encodeURIComponent(S.scope) : ''));
  S.scope = d.scope; S.me = d.me; S.db = d.db; S.budget = d.budget; S.scopes = d.scopes;
  $('#scopes').innerHTML = d.scopes.map(s => `<button class="chip mono${s.scope === d.scope ? ' on' : ''}" data-s="${esc(s.scope)}">${esc(slabel(s.scope))} <span style="opacity:.7">${s.n}</span></button>`).join('');
  $('#wake-eb').textContent = `SEGMEM_PROJECT=${short(d.scope)} segmem wake`;
  let sec = '', kind = '';
  $('#wake').innerHTML = d.wake.split('\n').map(line => {
    if (line.startsWith('#' + '#')) {
      sec = line; kind = /Identity/.test(line) ? 'identity' : /Procedural/.test(line) ? 'procedural' : /People/.test(line) ? 'people' : /Episodic/.test(line) ? 'episodic' : '';
      return `<div class="hd ${kind ? 'k-' + kind : 'ink2'}">${esc(line)}</div>`;
    }
    let m;
    if (sec.startsWith('### Episodic')) {
      const map = d.seq[(sec.match(/\((.*)\)/) || [])[1]] || {};
      if ((m = line.match(/^#(\d+)-(\d+) /))) return `<div class="ln"><span class="gut mut">#${m[1]}-${m[2]}</span><span class="tx">${esc(line.slice(m[0].length))}</span><span class="rid">summary</span></div>`;
      if ((m = line.match(/^#(\d+) /))) { const id = map[m[1]]; return `<div class="ln${id === S.sel ? ' on' : ''}" data-id="${id}"><span class="gut">#${m[1]}</span><span class="tx">${esc(line.slice(m[0].length))}</span><span class="rid">id ${id}</span></div>`; }
    } else if (/^#\d+ /.test(line)) {
      const ids = [...line.matchAll(/#(\d+) /g)].map(x => +x[1]);
      const tx = esc(line).replace(/OVERRIDDEN/, '<span class="ov">OVERRIDDEN</span>').replace(/^#(\d+) /, '<span class="acc">#$1</span> ');
      return `<div class="ln${ids.includes(S.sel) ? ' on' : ''}" data-id="${ids[0]}"><span class="tx">${tx}</span></div>`;
    }
    return `<div class="pl${/^You are awake/.test(line) ? ' awake' : ''}">${esc(line)}</div>`;
  }).join('');
  if (S.sel) loadFact(S.sel);
}
async function loadFact(id) {
  S.sel = id;
  document.querySelectorAll('#wake .ln').forEach(el => el.classList.toggle('on', +el.dataset.id === id));
  document.querySelectorAll('#spine rect').forEach(r => r.setAttribute('opacity', +r.dataset.id === id ? '1' : '.35'));
  const f = await j('/api/fact?id=' + id);
  $('#insp').innerHTML = f.error ? `<p class="mut">No memory #${id}.</p>` : factHTML(f);
}
function factHTML(f) {
  const me = S.me, ents = f.entities_list;
  const cmd = c => `<div class="cmd"><code>${esc(c)}</code><button class="cp" data-c="${esc(c)}">copy</button></div>`;
  let h = `<div class="fh"><span class="display id">#${f.id}</span><span class="k ${f.kind}"><i></i>${f.kind}</span><span class="mono mut" style="font-size:11.5px">${esc(slabel(f.scope))} · ${f.ts.slice(0, 10)} · seq ${f.seq} of ${f.total_in_stream}${f.dead ? ' · superseded' : ''}</span></div>
    <p class="ft${f.dead ? ' dead' : ''}" style="margin-top:10px">${esc(f.text)}</p>`;
  h += `<h4>Why it prints</h4><p class="ink2">${esc(f.why)}</p>`;
  if (ents.length) h += `<p style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">${ents.map(e => `<a class="tag" data-e="${esc(e)}">${esc(e)}</a>`).join('')}</p>`;
  if (f.conflicts.length) h += `<h4>Shares a subject with</h4>` + f.conflicts.map(c => `<div class="ln" data-id="${c.id}"><span class="acc mono">#${c.id}</span> ${esc(c.text)} <span class="mut">(${esc(short(c.scope))})</span></div>`).join('');
  if (f.threshold) {
    const pct = Math.min(100, 100 * f.pressure / f.threshold);
    h += `<h4>Pressure</h4><div class="bar"><i style="width:${pct}%"${f.hot ? ' class="hot"' : ''}></i></div>
      <p class="mut mono" style="font-size:11.5px">${f.pressure} / ${f.threshold} · ${fmtCounts(f.touches)} since ${f.since.slice(0, 10)}${f.last_touch ? ' · last ' + f.last_touch.slice(0, 16).replace('T', ' ') : ''}</p>
      <p${f.hot ? ' class="k-identity"' : ''}>${esc(f.verdict)}</p>`;
  } else if (ents.length) {
    h += `<h4>Touches</h4><p class="mut">${fmtCounts(f.touches)} since it was written; episodic notes carry no pressure.</p>`;
  }
  if (f.ladder) h += `<h4>Form ladder</h4><p class="mut">Export target: ${esc(f.ladder)}.</p>`;
  h += `<h4>History</h4><p class="mut">${f.replaces ? `Replaces <a class="ent mono" data-id="${f.replaces.id}">#${f.replaces.id}</a> (${f.replaces.ts.slice(0, 10)}). ` : ''}${f.superseded_by ? `Superseded by <a class="ent mono" data-id="${f.superseded_by.id}">#${f.superseded_by.id}</a> (${f.superseded_by.ts.slice(0, 10)}).` : 'Live; superseded by nothing.'}</p>`;
  h += `<h4>Commands · copy, never run from here</h4>`;
  if (f.kind === 'procedural' && !f.dead) h += cmd(`${me} touch ${f.id}`) + (f.hot ? cmd(`${me} touch ${f.id} --keep`) : '');
  if (!f.dead) h += cmd(`${me} note ${f.kind} "…" --supersedes=${f.id}${ents.length ? ' --entities=' + ents.join(',') : ''}`);
  if (ents.length) h += cmd(`${me} recall ${ents[0]}`);
  return h;
}

