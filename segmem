""" % c.execute("SELECT date('now')").fetchone()[0])
    print("Scaffolded %s.\nNext:\n  cd %s && git init && git add -A && "
          "git commit -m 'org: init'\n  export SEGMEM_ORG_DIR=%s" % (d, d, d))


def cmd_wake(c, args):
    p = project()
    scopes = [GLOBAL] if p == GLOBAL else [GLOBAL, p]
    out = ["## Memory (project: %s)" % short(p)]

    for kind, title in (("identity", "Identity"), ("procedural", "Procedural")):
        rows = live(c, kind, scopes)
        if not rows:
            continue
        out.append("\n### %s" % title)
        glob = [r for r in rows if r["scope"] == GLOBAL]
        proj = [r for r in rows if r["scope"] != GLOBAL]
        # Conflict: a project row sharing a subject with a global row. Project
        # wins, and both are shown so the agent sees why.
        conflicted = set()
        for pr in proj:
            for g in glob:
                if entity_set(pr) & entity_set(g):
                    conflicted.update((pr["id"], g["id"]))
                    out.append("#%d %s (global) OVERRIDDEN by #%d %s (%s)"
                               % (g["id"], g["text"], pr["id"], pr["text"], short(p)))
        for r in rows:
            if r["id"] not in conflicted:
                out.append("#%d %s (%s)" % (r["id"], r["text"], short(r["scope"])))
        if kind == "procedural":
            for row, p2, n2, since, reviewed, kept in note_pressure(c, scopes):
                if p2 < PROC_STALE_MIN:
                    continue
                if reviewed and not kept:
                    out.append("#%d is stable and hot (%s since %s): compile it into the repo "
                               "(enforce > skill > CLAUDE.md > docs) and supersede with a "
                               "pointer, or: %s touch %d --keep"
                               % (row["id"], fmt_counts(n2), since[:10], ME, row["id"]))
                else:
                    out.append("#%d under pressure (%s since %s): verify against the repo, "
                               "then supersede or: %s touch %d"
                               % (row["id"], fmt_counts(n2), since[:10], ME, row["id"]))

    oc = org_connect()
    if oc:
        ofacts = org_live(oc)
        n_cand = sum(1 for r in ofacts if r["status"] == "candidate")
        head = (oc.execute("SELECT v FROM meta WHERE k='head'").fetchone() or [""])[0]
        out.append("\n### Org layer: %d facts (%d candidates)%s; recall searches them."
                   % (len(ofacts) - n_cand, n_cand, " @ %s" % head[:7] if head else ""))
        loc = live(c, "identity", scopes) + live(c, "procedural", scopes)
        for of in ofacts:
            oe = {e.strip().lower() for e in of["entities"].split(",") if e.strip()}
            if of["status"] == "fact":
                # The contradiction report: a nearer fact beating an org fact
                # is the org layer's staleness signal (ARCHITECTURE.md).
                for lr in loc:
                    if oe & entity_set(lr):
                        out.append("org:%s %s (org) OVERRIDDEN by #%d %s (%s); if the "
                                   "org fact is wrong, open an issue on %s"
                                   % (of["slug"], of["text"], lr["id"], lr["text"],
                                      short(lr["scope"]), of["path"]))
                        break
            else:
                for lr in loc:
                    if lr["kind"] == "procedural" and norm(lr["text"]) == norm(of["text"]):
                        out.append("your #%d matches candidate %s: co-sign it (add a "
                                   "witness line to %s via PR)"
                                   % (lr["id"], of["slug"], of["path"]))
                        break

    people = live(c, "people", scopes)
    if people:
        names = {}
        for r in people:
            for e in r["entities"].split(","):
                if e.strip():
                    names.setdefault(e.strip().lower(), e.strip())
        out.append("\n### People known: %s" % ", ".join(names[k] for k in sorted(names)))
        out.append("Run `%s recall <name>` before acting on or about them." % ME)
        for e, pe, n, since in dossier_pressure(c):  # not p: that is the project
            if pe >= STALE_MIN and e in names:
                out.append("%s: dossier from %s, %s since. Supersede it or, if unchanged: "
                           "%s touch %s" % (names[e], since[:10], fmt_counts(n), ME, e))

    streams = [(GLOBAL, WAKE_EPISODIC)] if p == GLOBAL else \
        [(p, WAKE_EPISODIC), (GLOBAL, WAKE_EPISODIC_GLOBAL)]
    for sc, budget in streams:
        T = stream_len(c, "episodic", sc)
        if not T:
            continue
        out.append("\n### Episodic (%s), oldest first" % short(sc))
        for lo, hi in cover(T, budget):
            if hi - lo == 1:
                r = c.execute("SELECT ts, text FROM memories WHERE kind='episodic' AND scope=? AND seq=?",
                              (sc, lo)).fetchone()
                out.append("#%d %s %s" % (lo, r[0][:10], r[1]))
            else:
                s = summary(c, "episodic", sc, lo, hi)
                if s is None:
                    todo = pending(c, "episodic", sc, T)
                    print("\n".join(out))
                    print("\nCannot wake: #%d-%d is not compressed yet. Do the %d compression%s "
                          "below, then run %s wake again.\n" % (lo, hi - 1, len(todo),
                                                                "" if len(todo) == 1 else "s", ME))
                    print(nap_prompt(c, "episodic", sc, *todo[0], len(todo) - 1))
                    # exit 0: as a SessionStart hook, a failed command would
                    # hide this output. The text already says what to do.
                    sys.exit(0)
                out.append("#%d-%d %s %s" % (lo, hi - 1, span(c, sc, lo, hi), s))
    print("\n".join(out))
    print("\nYou are awake.")
    nap = next_nap(c, p)
    if nap:
        print("\n" + nap[1])


HOOK_MAX = 8
STOP = set("""i a an the and or but if then of to in on at for with from by as is are was
were be been this that these those it its my me we our you your they their he she
his her what which who how when where why do does did can could should would will
just also not no yes please let make add fix run use new old all any some into""".split())


def identifiers(text, tags=()):
    """Words in a prompt worth looking up: code spans, #123, paths and
    snake/kebab names, and capitalised words that are known tags. A proper
    noun that nobody tagged is prose, not an identifier: "Claude" would
    otherwise match every memory."""
    found = []
    for tok in re.findall(r"`([^`]+)`", text):
        found += tok.split()
    found += re.findall(r"#\d+", text)
    found += re.findall(r"[A-Za-z][\w./-]*[_/.-][\w./-]*", text)
    found += [w for w in re.findall(r"\b[A-Z][a-zA-Z0-9]{2,}\b", text) if w.lower() in tags]
    out, seen = [], set()
    for f in found:
        k = f.strip("`.,;:()[]{}'\"").lower()
        if len(k) > 2 and k not in STOP and k not in seen:
            seen.add(k)
            out.append(f.strip("`.,;:()[]{}'\""))
    return out


def cmd_hook(c, args):
    """Claude Code UserPromptSubmit hook: reads the prompt as JSON on stdin,
    prints matching memories as extra context. Never fails the prompt."""
    import json
    sid = ""
    try:
        data = json.load(sys.stdin)
        text = data.get("prompt", "") if isinstance(data, dict) else ""
        sid = data.get("session_id", "") if isinstance(data, dict) else ""
    except Exception:
        text = sys.stdin.read() if not sys.stdin.isatty() else ""
    tags = known_tags(c)
    ids = identifiers(text, tags)
    if not ids:
        return
    try:
        touch(c, [i for i in ids if i.lower() in tags], "prompt", sid)
    except sqlite3.OperationalError:
        pass
    q = " OR ".join('"%s"' % i.replace('"', '""') for i in ids)
    p = project()
    try:
        rows = c.execute(
            "SELECT m.* FROM memories_fts f JOIN memories m ON m.id=f.rowid "
            "WHERE memories_fts MATCH ? AND m.scope IN (?,?) AND %s "
            "ORDER BY rank LIMIT ?" % LIVE, (q, GLOBAL, p, HOOK_MAX)).fetchall()
    except sqlite3.OperationalError:
        return
    oc = org_connect()
    orows = org_search(oc, q, HOOK_MAX - len(rows)) if oc and len(rows) < HOOK_MAX else []
    if not rows and not orows:
        return
    print("<segmem-recall>")
    for r in rows:
        print("#%d %s %s %s: %s" % (r["id"], r["ts"][:10], r["kind"], short(r["scope"]), r["text"]))
    for r in orows:
        print(org_line(r, path=False))
    print("</segmem-recall>")


