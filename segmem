  if (t.dataset.id && t.dataset.tscope) { S.scope = S.treeScope; S.sel = +t.dataset.id; setTab('console'); return; }
  if (t.dataset.id) { const id = +t.dataset.id; if (S.tab === 'ledger' && !t.closest('#feed') && !t.closest('td.x') && !t.closest('#spine')) { if (!S.open.includes(id)) S.open.push(id); loadLedger(); } else { S.sel = id; setTab('console'); } }
});
