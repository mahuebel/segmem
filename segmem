const VIEWS = {overview: loadOverview, console: loadConsole, ledger: loadLedger, hook: loadHook, tree: loadTree, entities: loadEntities, lineage: loadLineage};
function refresh() { loadSpine().then(() => { if (S.tab === 'overview' || S.tab === 'tree') VIEWS[S.tab](); }); if (S.tab !== 'overview' && S.tab !== 'tree') VIEWS[S.tab](); loadFeed(); }
function setTab(tab) {
  S.tab = tab;
  document.querySelectorAll('nav button').forEach(b => b.classList.toggle('on', b.dataset.t === tab));
  document.querySelectorAll('section').forEach(s => s.classList.toggle('on', s.id === tab));
