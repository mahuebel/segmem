# ---------------------------------------------------------------- serve
# A live page over the store: stdlib http.server, loopback only, foreground
# (Ctrl-C stops it). Read-only: every route is a SELECT, and search skips the
# touch() that recall performs, so browsing never presses on a fact. Nothing
# in the hot path depends on it, so the no-daemon promise holds.

SERVE_PORT = 7878


def parse_query(q):
    """Split a ledger query into (fts_terms, filters).

    TODO(Mark): the chip grammar is yours. Today the whole string goes to
    FTS5 and filters arrive only from facet clicks (?kind= ?scope= ?entity=).
    Decide what a typed `scope:kerf`, `kind:procedural`, `since:7d`, or
    `superseded:yes` should mean, and return them in `filters` under the
    keys serve_search() already reads: kind, scope (full path or short
    name), entity, since (ISO date prefix, so "7d" needs converting), dead
    ("1" shows superseded rows). Words that are not chips stay in the FTS
    string; an empty FTS string lists newest first.
    """
    return q.strip(), {}


def fts_rows(c, sql, terms, params):
    """Run an FTS5 MATCH, retrying with quoted terms as recall does."""
    try:
        return c.execute(sql, (terms, *params)).fetchall()
    except sqlite3.OperationalError:
        quoted = " ".join(t if t in ("OR", "AND", "NOT") else '"%s"' % t.replace('"', '""')
                          for t in terms.split())
        return c.execute(sql, (quoted, *params)).fetchall()


def serve_search(c, q, f):
    import time
    t0 = time.time()
    terms, chips = parse_query(q)
    f = {**f, **chips}
    where, params = [], []
    if f.get("kind"):
        where.append("m.kind=?")
        params.append(f["kind"])
    if f.get("scope"):
        where.append("(m.scope=? OR m.scope LIKE ?)")
        params.extend((f["scope"], "%/" + f["scope"]))
    if f.get("entity"):
        where.append("(','||lower(m.entities)||',') LIKE ?")
        params.append("%%,%s,%%" % f["entity"].lower())
    if f.get("since"):
        where.append("m.ts>=?")
        params.append(f["since"])
    if f.get("dead") != "1":
        where.append("m.id NOT IN (SELECT supersedes FROM memories WHERE supersedes IS NOT NULL)")
    tail = "".join(" AND " + w for w in where)
    if terms:
        sql = ("SELECT m.* FROM memories_fts x JOIN memories m ON m.id=x.rowid "
               "WHERE memories_fts MATCH ?%s ORDER BY rank" % tail)
        try:
            rows = fts_rows(c, sql, terms, params)
        except sqlite3.OperationalError as e:
            return {"error": "Bad query: %s" % e, "rows": [], "total": 0, "facets": {}, "ms": 0}
    else:
        rows = c.execute("SELECT m.* FROM memories m WHERE 1%s ORDER BY m.id DESC" % tail,
                         params).fetchall()
    dead = {r[0] for r in c.execute("SELECT supersedes FROM memories WHERE supersedes IS NOT NULL")}
    facets = {"kind": {}, "scope": {}, "entity": {}}
    for r in rows:
        facets["kind"][r["kind"]] = facets["kind"].get(r["kind"], 0) + 1
        facets["scope"][r["scope"]] = facets["scope"].get(r["scope"], 0) + 1
        for e in entity_set(r):
            facets["entity"][e] = facets["entity"].get(e, 0) + 1
    facets["entity"] = dict(sorted(facets["entity"].items(), key=lambda kv: (-kv[1], kv[0]))[:14])
    out = [dict(r, dead=r["id"] in dead) for r in rows[:200]]
    return {"rows": out, "total": len(rows), "facets": facets, "filters": f,
            "ms": round((time.time() - t0) * 1000, 1)}


