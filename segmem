$('#tb').value = D.budget; $('#tbv').textContent = D.budget;
if (epiScopes.includes(D.project)) $('#ts').value = D.project;
function renderTree() {
  const sc = $('#ts').value, budget = +$('#tb').value; $('#tbv').textContent = budget;
  const stream = D.memories.filter(m => m.scope === sc && m.kind === 'episodic').sort((a, b) => a.seq - b.seq);
  const T = stream.length, sums = Object.fromEntries(D.summaries.filter(s => s.scope === sc).map(s => [s.lo + '-' + s.hi, s.text]));
  if (!T) { $('#treesvg').innerHTML = ''; $('#preview').textContent = ''; $('#pending').innerHTML = ''; return; }
  const cov = cover(T, budget), covSet = new Set(cov.map(([a, b]) => a + '-' + b));
  let root = 1; while (root < T) root *= 2;
  const levels = []; for (let s = 1; s <= root; s *= 2) levels.push(s);
  const W = 1000, rowH = 22, gap = 3, H = levels.length * (rowH + gap);
  let svg = `<svg viewBox="0 0 ${W} ${H}">`;
  levels.slice().reverse().forEach((size, li) => {
    const y = li * (rowH + gap);
    for (let lo = 0; lo < T; lo += size) {
      const hi = Math.min(lo + size, root), k = lo + '-' + (lo + size), x = lo / T * W, w = (Math.min(lo + size, T) - lo) / T * W - 1;
      const isLeaf = size === 1, sum = sums[k], cls = ['blk', isLeaf ? 'leaf' : (sum ? 'sum' : ''), covSet.has(k) ? 'cov' : ''].join(' ');
      const label = isLeaf ? stream[lo].text : (sum || `#${lo}-${lo + size - 1}: not summarised`);
      svg += `<rect class="${cls}" x="${x}" y="${y}" width="${Math.max(w, 1)}" height="${rowH}" rx="2"><title>#${lo}-${lo + size - 1}\n${esc(label)}</title></rect>`;
      if (w > 40) svg += `<text x="${x + 4}" y="${y + 15}" font-size="11" fill="var(--mut)" pointer-events="none">#${lo}${size > 1 ? '-' + (lo + size - 1) : ''}</text>`;
    }
  });
  $('#treesvg').innerHTML = svg + '</svg>';
  const lines = [], missing = [];
  for (const [lo, hi] of cov) {
    if (hi - lo === 1) lines.push(`#${lo} ${stream[lo].text}`);
    else { const s = sums[lo + '-' + hi]; lines.push(`#${lo}-${hi - 1} ${s || '⟨missing summary⟩'}`); if (!s) missing.push([lo, hi]); }
  }
  $('#preview').textContent = lines.join('\n');
  // what nap would ask for: smallest missing block the cover needs, with its missing halves
  const need = []; const walk = (lo, hi) => { if (hi - lo === 1 || sums[lo + '-' + hi]) return; const mid = (lo + hi) >> 1; walk(lo, mid); walk(mid, hi); need.push([lo, hi]); };
  cov.forEach(([a, b]) => walk(a, b)); need.sort((a, b) => (a[1] - a[0]) - (b[1] - b[0]) || a[0] - b[0]);
  $('#pending').innerHTML = need.length ? `<div class="card"><b>${need.length} compression${need.length > 1 ? 's' : ''} due at this budget.</b> First: #${need[0][0]}-${need[0][1] - 1} <button class="cp" data-c='${esc(D.me)} nap ${need[0][0]}-${need[0][1] - 1} "&lt;your line&gt;"'>copy nap command</button></div>` : '<p class="mut">Nothing due at this budget.</p>';
}
$('#ts').onchange = renderTree; $('#tb').oninput = renderTree; renderTree();
document.body.addEventListener('click', e => { if (e.target.classList.contains('cp')) { navigator.clipboard.writeText(e.target.dataset.c.replace(/&lt;/g, '<').replace(/&gt;/g, '>')); e.target.textContent = 'copied'; } });

