// ---- cover(): the same greedy as the Python, so the slider is exact
function cover(T, budget) {
  if (T <= 0) return [];
  if (T <= budget) return Array.from({length: T}, (_, i) => [i, i + 1]);
  let root = 1; while (root < T) root *= 2;
  const key = (lo, hi) => hi > T ? [-1, -lo] : [(T - lo) / (hi - lo), -lo];
  const less = (a, b) => a[0][0] !== b[0][0] ? a[0][0] < b[0][0] : a[0][1] < b[0][1];
  let heap = [[key(0, root), 0, root]], done = [];
  while (heap.length && heap.length + done.length < budget) {
    heap.sort((a, b) => less(a, b) ? -1 : 1);
    const [, lo, hi] = heap.shift(), mid = (lo + hi) >> 1;
    for (const [a, b] of [[lo, mid], [mid, hi]]) {
      if (a >= T) continue;
      if (b - a === 1) done.push([a, b]); else heap.push([key(a, b), a, b]);
    }
  }
  let out = done.concat(heap.map(h => [h[1], h[2]]));
  const fixed = [];
  for (let [lo, hi] of out) {
    while (hi > T) { const mid = (lo + hi) >> 1; if (mid >= T) hi = mid; else { fixed.push([lo, mid]); lo = mid; } }
    fixed.push([lo, hi]);
  }
  return fixed.sort((a, b) => a[0] - b[0]);
}

